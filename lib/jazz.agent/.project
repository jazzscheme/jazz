;;;==============
;;;  JazzScheme
;;;==============
;;;
;;;; Project
;;;


(data jazz.ide.data.project


(import (jazz.editor.jazz))


(form
  (<Project>                 name: jazz.agent            description-file: {File :context ".package"}
    (<Project-Directory>                                 directory: {Directory :context "src"}
      (<Project-Directory>                               directory: {Directory :context "src" "jazz"}
        (<Project-Directory>                             directory: {Directory :context "src" "jazz" "agent"}
          (<Jazz-File>       name: _agent                source: {File :context "src" "jazz" "agent" "_agent.jazz"})
          (<Jazz-File>       name: Agent-Console-Manager source: {File :context "src" "jazz" "agent" "Agent-Console-Manager.jazz"})
          (<Jazz-File>       name: Agent-Console-View    source: {File :context "src" "jazz" "agent" "Agent-Console-View.jazz"})
          (<Jazz-File>       name: Agent-Text-View       source: {File :context "src" "jazz" "agent" "Agent-Text-View.jazz"})
          (<Jazz-File>       name: autoload              source: {File :context "src" "jazz" "agent" "autoload.jazz"})))))))
