(module protected jazz.agent.Agent-Console-Manager jazz


(import (jazz.agent)
        (jazz.console)
        (jazz.event)
        (jazz.graphic)
        (jazz.handler)
        (jazz.layout)
        (jazz.markup)
        (jazz.menu)
        (jazz.resource)
        (jazz.ui)
        (jazz.view))


(class Agent-Console-Manager extends Console-Manager
    
  
  (method meta override (external-name self . rest)
    'Agents)

  
  ;;;
  ;;;; Host
  ;;;
  
  
  (method meta override (host-icon self)
    {Image-Resource "Designer"})
  
  
  (method meta override (host-title self)
    "Agents")


  ;;;
  ;;;; Toolbar
  ;;;


  (form
    (<install>
      (<!> name: tools
        ;;(<!> name: detail visible?: #f)
        (<Push-Tool>   name: new-chat  size: {Dimension 22 22} tooltip?: #t tooltip-text: "New Chat" resource: {Image-Resource "New"} portfolio: :images action-handler: {Event-Handler :guest on-new-chat})
        (<Push-Tool>   name: chats     size: {Dimension 22 22} tooltip?: #t tooltip-text: "Saved Chats..." resource: {Image-Resource "Open"} portfolio: :images action-handler: {Event-Handler :guest on-saved-chats-menu})
        (<Push-Tool>   name: save-chat size: {Dimension 22 22} tooltip?: #t tooltip-text: "Save Chat" resource: {Image-Resource "Save"} portfolio: :images action-handler: {Event-Handler :guest on-save-chat})
        (<Separator>)
        (<Push-Tool>   name: stop      size: {Dimension 22 22} enabled?: #f tooltip?: #t tooltip-text: "Stop Generation (Escape)" resource: {Image-Resource "Stop"} portfolio: :images action-handler: {Event-Handler :guest on-stop-query})
        (<Toggle-Tool> name: dictate   size: {Dimension 22 22} tooltip?: #t tooltip-text: "Dictate (Voice) (Ctrl+Return)" resource: {Image-Resource "Record"} portfolio: :images action-handler: {Event-Handler :guest on-toggle-dictate}))))

  
  ;;;
  ;;;; Console
  ;;;
  
  
  (method override (console-class self)
    Agent-Console-View)


  (method public (ensure-console self)
    (or (get-text self)
        (let ((text (register-console self "Agent" #t process-title: "Agent")))
          (show-banner text)
          text)))


  (method override (focus-default self)
    (let ((text (ensure-console self)))
      (when text
        (acquire-focus text))))


  ;;;
  ;;;; Events
  ;;;


  (method public (get-stop-tool self)
    (locate-component self 'stop))


  (method public (get-dictate-tool self)
    (locate-component self 'dictate))


  (method (on-stop-query self evt)
    (let ((text (ensure-console self)))
      (when text
        (stop-query text))))


  (method (on-new-chat self evt)
    (let ((text (ensure-console self)))
      (new-conversation text)))


  (method (on-save-chat self evt)
    (let ((text (ensure-console self)))
      (when text
        (save-conversation-to-disk text))))


  (method (on-toggle-dictate self evt)
    (let ((text (ensure-console self)))
      (when text
        (toggle-dictation text))))


  (method (on-saved-chats-menu self evt)
    (let* ((sender (get-sender evt))
           (pos (new Point 0 (get-height (get-size sender))))
           (menu (new Saved-Chats-Menu manager: self)))
      (track-popup-menu sender menu pos))))


;;;
;;;; Saved-Chats-Menu
;;;


(class Saved-Chats-Menu extends Context-Menu
  
  
  (property manager accessors generate)
  
  
  (method override (finish self rest)
    (nextmethod self rest)
    (let ((chats (list-saved-conversations)))
      (if (null? chats)
          (new Label-Item parent: self title: "No Saved Chats" enabled?: #f)
        (for-each
          (lambda (chat)
            (bind (file title id) chat
              (new Label-Item parent: self
                              title: title
                              action-handler: (new Event-Handler
                                                target: self
                                                method-name: 'on-select-chat
                                                properties: (list file: file)))))
          chats))))
  
  
  (method (on-select-chat self evt)
    (let ((file (get-property evt file:))
          (text (ensure-console manager)))
      (when (and file text)
        (load-conversation-from-file text file))))))

