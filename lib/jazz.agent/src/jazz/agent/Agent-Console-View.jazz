(module protected jazz.agent.Agent-Console-View jazz


(import (jazz.agent)
        (jazz.console)
        (jazz.event)
        (jazz.graphic)
        (jazz.handler)
        (jazz.layout)
        (jazz.markup)
        (jazz.resource)
        (jazz.ui)
        (jazz.view))


(class undocumented Agent-Console-View extends Layout-View implements Console-Host
  
  
  (property button initialize #f getter explicit)
  
  
  (form
    (<install>                                   layout-type: border background: {Color Medium}
      (<View>                                    size: {Dimension 100 1} location: north background: {Color Dark})
      (<Layout-View>                             size: {Dimension 100 24} location: north layout-type: box layout-insets: {Rect 0 1 0 0} layout-padding: 2
        (<Label-View>                            title: "Effort:" size: {Dimension 45 23} location: tail)
        (<Layout-View>                           size: {Dimension 85 22} layout-type: fill layout-insets: {Rect 0 2 0 2} location: tail
          (<Border-View>                         border-color: {Color Dark}
            (<Combo-Box>          name: effort   content-change-handler: {Event-Handler :form on-change-effort}))))
      (<Scroller-View>                           location: center style: tool vscroll?: #t hscroll?: #t
        (<!>                      name: content
          (<Agent-Text-View>      name: text)))))
  
  
  (method override (get-button self)
    button)
  
  
  (method override (get-text self)
    (locate self 'text))
  
  
  (method override (finish self initargs)
    (nextmethod self initargs)
    (let ((combo (locate self 'effort)))
      (set-choices combo
        '((minimal "Minimal")
          (low "Low")
          (medium "Medium")
          (high "High")))
      (set-value combo (or (and (get-text self) (get-agent-effort (get-text self))) 'low))))
  
  
  (method (on-change-effort self evt)
    (let ((value (get-value (locate self 'effort)))
          (text (get-text self)))
      (when (and value text)
        (set-agent-effort text value))))))
