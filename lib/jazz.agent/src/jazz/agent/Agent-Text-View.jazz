(module protected jazz.agent.Agent-Text-View jazz


(import (jazz.action)
        (jazz.agent)
        (jazz.ai)
        (jazz.component)
        (jazz.console)
        (jazz.event)
        (jazz.exemplar)
        (jazz.graphic)
        (jazz.handler)
        (jazz.ide)
        (jazz.io)
        (jazz.json)
        (jazz.locale)
        (jazz.markup)
        (jazz.media)
        (jazz.menu)
        (jazz.preferences)
        (jazz.resource)
        (jazz.text)
        (jazz.text.preferences)
        (jazz.ui)
        (jazz.view))


(class undocumented Agent-Text-View extends Console-Text-View
  
  
  (slot conversation-id       initialize #f accessors generate)
  (slot conversation-title    initialize #f accessors generate)
  (slot conversation-file     initialize #f accessors generate)
  (slot conversation-messages initialize '() accessors generate)
  (slot response-id           initialize #f accessors generate)
  (slot agent-profile         initialize 'coder accessors generate)
  (slot agent-effort          initialize 'low accessors generate)
  (slot agent-context         initialize #f accessors generate)
  (slot query-running?        initialize #f accessors generate)
  (slot query-thread          initialize #f accessors generate)
  (slot query-port            initialize #f accessors generate)
  (slot dictation-port        initialize #f accessors generate)
  (slot dictation-thread      initialize #f accessors generate)
  (slot dictation-range       initialize #f accessors generate)
  (slot dictation-running?    initialize #f accessors generate)
  (slot active-task           initialize #f accessors generate)
  
  
  (method override (auto-complete? self)
    #f)
  

  (method override (install self rest)
    (nextmethod self rest)
    (add-style self 'Gray (get-comment-style (preferences self)))
    (set! banner (format "Agent v1.0{%}{%}"))
    (set! banner-prompt "> "))
  
  
  (method override (get-console self)
    (get-parent (get-parent (get-parent self))))
  

  (method package (show-banner self)
    (insert-styled self banner 'Banner)
    (insert-styled self banner-prompt 'Prompt))
  
  
  (method package (agent-trace self text)
    (insert-styled self text 'Gray)
    (ensure-displayed self)
    (update-view self))
  
  
  (method package (agent-restore-prompt self)
    (insert-styled self (or banner-prompt "> ") 'Prompt)
    (ensure-displayed self)
    (update-view self))
  
  
  (method package (agent-fail self exc)
    (set! query-running? #f)
    (set! query-thread #f)
    (set! query-port #f)
    (update-stop-tool self #f)
    (insert-styled self (format "Error: {a}" exc) 'Output)
    (insert-newline self)
    (insert-newline self)
    (agent-restore-prompt self))
  
  
  (method public (stop-query self)
    (when query-running?
      (set! query-running? #f)
      (let ((port query-port)
            (thread query-thread))
        (set! query-port #f)
        (set! query-thread #f)
        (when port
          (close-port port))
        (when thread
          (thread-terminate! thread))
        (update-stop-tool self #f)
        (insert-newline self)
        (insert-styled self "[Interrupted]" 'Comment)
        (insert-newline self)
        (insert-newline self)
        (agent-restore-prompt self)
        (set-caret self (text-ending self))
        (acquire-focus self))))
  
  
  (method public (get-effective-system-prompt self)
    (let ((base (get-agent-system-prompt (or agent-profile 'coder)))
          (ctx (and agent-context (get-context-content agent-context))))
      (if ctx
          (string-append base "\n\n=== ATTACHED CONTEXT (" agent-context ") ===\n" ctx "\n==========================================")
        base)))
  
  
  (method override (eval-from-prompt self)
    (when dictation-running?
      (stop-dictation self))
    (when query-running?
      (stop-query self))
    (insert-newline self)
    (let ((range (current-command self)))
      (let ((raw-input (trim-trailing-whitespace (get-string self range))))
        (unless (empty-string? raw-input)
          (stylize-range model range (locate-style self 'Input))
          (reset inserted)
          (let* ((cont-info (parse-continue-command raw-input))
                 (question (if cont-info
                               (format-continue-prompt cont-info task: active-task)
                             (begin
                               (set! active-task raw-input)
                               raw-input))))
            (unless cont-info
              (set! response-id #f))
            (unless conversation-id
              (set! conversation-id (generate-conversation-id)))
            (when (or (not conversation-title)
                      (equal? conversation-title "New Chat"))
              (set! conversation-title (conversation-title-from-prompt question))
              (update-console-title self))
            (set! query-running? #t)
            (update-stop-tool self #t)
            (let ((thread
                    (new-thread
                      (lambda ()
                        (gemini-agent-query
                          question
                        system: (get-effective-system-prompt self)
                        effort: (or agent-effort 'low)
                        response-id: response-id
                        history: conversation-messages
                        cancelled?: (lambda () (not query-running?))
                        on-port: (lambda (port) (set! query-port port))
                        on-id: (lambda (id) (set! response-id id))
                        on-complete:
                        (lambda (answer final-resp-id history)
                          (post-event
                            (lambda ()
                              (when query-running?
                                (set! query-running? #f)
                                (set! query-thread #f)
                                (set! query-port #f)
                                (update-stop-tool self #f)
                                (set! response-id final-resp-id)
                                (set! conversation-messages
                                  (append conversation-messages
                                          (list (list 'user question)
                                                (list 'agent (trim-trailing-whitespace answer)))))
                                (save-conversation-to-disk self)
                                (insert-styled self answer 'Output)
                                (insert-newline self)
                                (insert-newline self)
                                (agent-restore-prompt self)
                                (play-sound "Pop")))))
                        on-status:
                        (lambda (status)
                          @w
                          (post-event
                            (lambda ()
                              (when query-running?
                                (agent-trace self (format "{a}\n" status))))))
                        on-thought:
                        (lambda (thought)
                          (post-event
                            (lambda ()
                              (when query-running?
                                (agent-trace self (format "Thinking: {a}\n" thought))))))
                        on-action:
                        (lambda (action-table)
                          (let ((action (table-ref action-table "action" #f))
                                (simplify (lambda (p) (simplify-action-path p agent-context))))
                            (let ((desc
                                    (cond ((equal? action "grep")
                                           (let ((dir (table-ref action-table "dir" #f)))
                                             (if (and dir (not (equal? dir "")) (not (equal? dir ".")))
                                                 (format "grep \"{a}\" in {a}" (table-ref action-table "pattern" "") (simplify dir))
                                               (format "grep \"{a}\"" (table-ref action-table "pattern" "")))))
                                          ((equal? action "locate")
                                           (let ((dir (table-ref action-table "dir" #f)))
                                             (if (and dir (not (equal? dir "")) (not (equal? dir ".")))
                                                 (format "locate {a} in {a}" (table-ref action-table "pattern" "") (simplify dir))
                                               (format "locate {a}" (table-ref action-table "pattern" "")))))
                                          ((equal? action "list_directory")
                                           (format "list_directory {a}" (simplify (table-ref action-table "path" ""))))
                                          ((equal? action "read")
                                           (let ((path (simplify (table-ref action-table "path" "")))
                                                 (offset (table-ref action-table "offset" #f))
                                                 (limit (table-ref action-table "limit" #f)))
                                             (cond ((and offset limit)
                                                    (format "read {a} (lines {a}-{a})" path offset (+ offset limit -1)))
                                                   (offset
                                                    (format "read {a} (lines {a}-...)" path offset))
                                                   (else
                                                    (format "read {a}" path)))))
                                          ((equal? action "replace")
                                           (format "replace in {a}" (simplify (table-ref action-table "path" ""))))
                                          ((equal? action "write")
                                           (format "write {a}" (simplify (table-ref action-table "path" ""))))
                                          ((equal? action "run_test")
                                           (let ((target (table-ref action-table "target" #f)))
                                             (if (or (not target) (equal? target "") (equal? target "?"))
                                                 "run_test missing target"
                                               (format "run_test {a}" target))))
                                          ((equal? action "git")
                                           (format "git {a} in {a}" (table-ref action-table "args" "") (simplify (table-ref action-table "dir" ""))))
                                           ((equal? action "search_definitions")
                                            (format "search_definitions \"{a}\"" (table-ref action-table "pattern" "")))
                                           ((equal? action "search_references")
                                            (format "search_references \"{a}\"" (table-ref action-table "pattern" "")))
                                           ((equal? action "gsc")
                                           (let ((dir (table-ref action-table "dir" #f)))
                                             (if (and dir (not (equal? dir "")) (not (equal? dir ".")))
                                                 (format "gsc {a} in {a}" (table-ref action-table "args" "") (simplify dir))
                                               (format "gsc {a}" (table-ref action-table "args" "")))))
                                          (else
                                           (format "{a}" (or action "?"))))))
                              (post-event
                                (lambda ()
                                  (when query-running?
                                    (agent-trace self (format "Action: {a}\n" desc))))))))))
                    'agent-query)))
            (set! query-thread thread)
            (thread-start! thread)))))))
  
  
  (method public (new-conversation self)
    (when dictation-running?
      (stop-dictation self))
    (when query-running?
      (stop-query self))
    (set! conversation-id (generate-conversation-id))
    (set! conversation-title "New Chat")
    (set! conversation-file #f)
    (set! conversation-messages '())
    (set! response-id #f)
    (set! agent-context #f)
    (set! active-task #f)
    (update-combos self)
    (clear-all self)
    (show-banner self)
    (set-caret self (text-ending self))
    (update-console-title self)
    (acquire-focus self))
  
  
  (method public (load-conversation-from-file self file)
    (when dictation-running?
      (stop-dictation self))
    (when query-running?
      (stop-query self))
    (bind (id title resp-id messages ctx f) (load-conversation file)
      (set! conversation-id id)
      (set! conversation-title title)
      (set! conversation-file f)
      (set! response-id resp-id)
      (set! conversation-messages (or messages '()))
      (set! agent-context ctx)
      (set! active-task #f)
      (update-combos self)
      (clear-all self)
      (when banner
        (insert-styled self banner 'Banner))
      (for-each
        (lambda (msg)
          (let ((role (car msg))
                (text (cadr msg)))
            (case role
              ((user)
               (insert-styled self (or banner-prompt "> ") 'Prompt)
               (insert-styled self (trim-trailing-whitespace text) 'Input)
               (insert-newline self))
              ((agent)
               (insert-styled self (trim-trailing-whitespace text) 'Output)
               (insert-newline self)
               (insert-newline self)))))
        conversation-messages)
      (insert-styled self (or banner-prompt "> ") 'Prompt)
      (set-caret self (text-ending self))
      (update-console-title self)
      (ensure-displayed self)
      (acquire-focus self)))
  
  
  (method public (update-combos self)
    (let ((console (get-console self)))
      (when console
        (let ((context-combo (locate console 'context))
              (effort-combo (locate console 'effort)))
          (when context-combo
            (set-value context-combo agent-context))
          (when effort-combo
            (set-value effort-combo (or agent-effort 'low)))))))
  
  
  (method public (save-conversation-to-disk self)
    (when (pair? conversation-messages)
      (unless conversation-id
        (set! conversation-id (generate-conversation-id)))
      (when (or (not conversation-title)
                (equal? conversation-title "New Chat"))
        (let ((first-msg (car conversation-messages)))
          (set! conversation-title (conversation-title-from-prompt (cadr first-msg))))))
    (when conversation-id
      (let ((file (save-conversation conversation-id
                                     (or conversation-title "New Chat")
                                     response-id
                                     conversation-messages
                                     conversation-file
                                     context: agent-context)))
        (set! conversation-file file)
        (update-console-title self)
        file)))
  
  
  (method package (update-console-title self)
    (let ((console (get-console self)))
      (when console
        (let ((button (get-button console)))
          (when button
            (let ((title (or conversation-title "New Chat")))
              ;; makes the button too wide for now
              ;; (set-title button title)
              (set-tooltip-text button title)
              (invalidate-view button)))))))
  
  
  (method (on-new-chat self evt)
    (new-conversation self))
  
  
  (method (on-save-chat self evt)
    (save-conversation-to-disk self))
  
  
  ;;;
  ;;;; Dictation
  ;;;


  (method override (return-press self evt)
    (if (and evt (get-control? evt))
        (toggle-dictation self)
      (nextmethod self evt)))


  (method (on-toggle-dictate self evt)
    (toggle-dictation self))


  (method public (toggle-dictation self)
    (if dictation-running?
        (stop-dictation self)
      (start-dictation self)))


  (method public (start-dictation self)
    (unless dictation-running?
      (let ((bin (find-dictate-executable)))
        (if (not bin)
            (agent-trace self "\nError: JediDictate helper not found.\n")
          (let ((port (open-process (list path: (parse bin) arguments: '() show-console: #f))))
            (set! dictation-port port)
            (set! dictation-running? #t)
            (let* ((ending (text-ending self))
                   (limit (get-limit self))
                   (home (home-column self limit 0))
                   (caret (get-caret self)))
              (when (or (< (get-line caret) limit)
                        (< (get-col caret) home))
                (set-caret self ending)
                (set! caret ending))
              (if (has-selection? self)
                  (set! dictation-range (get-selection self))
                (begin
                  (when (> (get-col caret) home)
                    (let ((c (get-char self (new Cell limit (- (get-col caret) 1)))))
                      (unless (memq? c '(#\space #\tab #\newline))
                        (insert-styled self " " 'Entry))))
                  (let ((caret (get-caret self)))
                    (set! dictation-range (new Range$Cell$ caret caret))))))
            (update-dictate-tool self #t)
            (acquire-focus self)
            (let ((thread
                    (new-thread
                      (lambda ()
                        (let loop ()
                          (let ((line (read-line port)))
                            (cond ((or (eof-object? line) (not dictation-running?))
                                   (close-port port)
                                   (post-event (lambda () (stop-dictation self))))
                                  (else
                                   (let ((json (string->json line)))
                                     (let ((type (table-ref json "type" #f)))
                                       (cond ((equal? type "transcript")
                                              (let ((text (table-ref json "text" ""))
                                                    (final? (table-ref json "is_final" #f)))
                                                (post-event
                                                  (lambda ()
                                                    (on-dictation-transcript self text final?)))))
                                             ((equal? type "error")
                                              (let ((msg (table-ref json "message" "Dictation error")))
                                                (post-event
                                                  (lambda ()
                                                    (on-dictation-error self msg)))))
                                             ((equal? type "status")
                                              (let ((st (table-ref json "status" #f)))
                                                (when (equal? st "stopped")
                                                  (post-event
                                                    (lambda ()
                                                      (stop-dictation self))))))))))))
                          (loop)))
                      'dictation-reader)))
              (set! dictation-thread thread)
              (thread-start! thread)))))))


  (method public (on-dictation-transcript self text final?)
    (when (and dictation-running? dictation-range)
      (let ((lines (split-lines text)))
        (let ((new-range (replace-styled self dictation-range lines 'Entry)))
          (when new-range
            (set! dictation-range new-range)
            (set-caret self (get-end new-range))
            (ensure-displayed self)
            (update-view self))
          (when final?
            (stop-dictation self))))))


  (method public (on-dictation-error self msg)
    (stop-dictation self)
    (agent-trace self (format "\nDictation error: {a}\n" msg)))


  (method public (stop-dictation self)
    (when dictation-running?
      (set! dictation-running? #f)
      (let ((port dictation-port))
        (set! dictation-port #f)
        (when port
          (display "stop\n" port)
          (force-output port)))
      (set! dictation-range #f)
      (update-dictate-tool self #f)))


  (method override (destroy self)
    (when dictation-running?
      (stop-dictation self))
    (when query-running?
      (stop-query self))
    (nextmethod self))


  (method override (escape-press self evt)
    (cond (query-running?
           (stop-query self))
          (dictation-running?
           (stop-dictation self))
          (else
           (nextmethod self evt))))


  (method (on-stop-query self evt)
    (stop-query self))


  (method package (update-stop-tool self active?)
    (let ((manager (get-agent-text-manager self)))
      (when manager
        (let ((tool (locate-component manager 'stop)))
          (when tool
            (set-enabled? tool active?)
            (invalidate-view tool))))))


  (method package (update-dictate-tool self active?)
    (let ((manager (get-agent-text-manager self)))
      (when manager
        (let ((tool (locate-component manager 'dictate)))
          (when tool
            (set-selected? tool active?)
            (set-resource tool (if active? {Image-Resource "RecordRed"} {Image-Resource "Record"}))
            (invalidate-view tool))))))
  
  
  (method override (console-menu self)
    (new Agent-Menu client: self)))


;;;
;;;; Agent-Menu
;;;


(class Agent-Menu extends Context-Menu
  
  
  (form
    (<install>
      (<Label-Item>     name: console-evaluate title: "Evaluate" icon: {Image-Resource "Import"} action-handler: {Action console-text console-evaluate})
      (<Label-Item>     name: stop-query       title: "Stop Generation" icon: {Image-Resource "Stop"} shortcut: {Shortcut Escape} action-handler: {Event-Handler (:form :client) on-stop-query})
      (<Label-Item>     name: fresh-prompt     title: "Fresh Prompt" action-handler: {Action console-text fresh-prompt})
      (<Separator-Item>)
      (<Label-Item>     name: new-chat         title: "New Chat" icon: {Image-Resource "New"} action-handler: {Event-Handler (:form :client) on-new-chat})
      (<Label-Item>     name: save-chat        title: "Save Chat" icon: {Image-Resource "Save"} action-handler: {Event-Handler (:form :client) on-save-chat})
      (<Separator-Item>)
      (<Label-Item>     name: toggle-dictate   title: "Dictate (Voice)" icon: {Image-Resource "Record"} shortcut: {Shortcut :control Return} action-handler: {Event-Handler (:form :client) on-toggle-dictate})
      (<Separator-Item>)
      (<Label-Item>     name: cut              title: {Locales english: "Cut" french: "Couper"} icon: {Image-Resource "Cut"} action-handler: {Action view cut})
      (<Label-Item>     name: copy             title: {Locales english: "Copy" french: "Copier"} icon: {Image-Resource "Copy"} action-handler: {Action view copy})
      (<Label-Item>     name: paste            title: {Locales english: "Paste" french: "Coller"} icon: {Image-Resource "Paste"} action-handler: {Action view paste})
      (<Separator-Item>)
      (<Label-Item>     name: insert-previous  title: "Insert Previous" icon: {Image-Resource "FindBackward"} action-handler: {Action console-text insert-previous})
      (<Label-Item>     name: insert-next      title: "Insert Next" icon: {Image-Resource "FindForward"} action-handler: {Action console-text insert-next})))))

