(module jazz.agent jazz


(export (jazz.agent.autoload))
(import (jazz.agent.autoload)
        (jazz.application)
        (jazz.component)
        (jazz.io)
        (jazz.json)
        (jazz.text)
        (jazz.view))


(definition public (get-agent-manager-guest)
  (get-guest (singleton-docked Agent-Console-Manager)))


(definition public (get-agent-text)
  (get-text (get-agent-manager-guest)))


(definition package (get-agent-text-manager text)
  (get-creator (get-parent (get-creator text))))


;;;
;;;; Chat Storage
;;;


(definition (plist-ref plist key (default #f))
  (let loop ((scan plist))
    (cond ((null? scan) default)
          ((and (pair? scan) (pair? (cdr scan)))
           (if (eq? (car scan) key)
               (cadr scan)
             (loop (cddr scan))))
          (else default))))


(definition *chats-directory*
  #f)


(definition public (get-chats-directory)
  *chats-directory*)


(definition public (set-chats-directory dir)
  (set! *chats-directory* dir))


(definition public (find-chats-directory)
  (let ((dir (or *chats-directory*
                 {Directory Settings "chats"})))
    (unless (exists? dir)
      (create-directories dir))
    dir))


;;;
;;;; Dictation
;;;


(definition *dictate-executable*
  #f)


(definition public (get-dictate-executable)
  *dictate-executable*)


(definition public (set-dictate-executable file)
  (set! *dictate-executable* file))


(definition public (find-dictate-executable)
  (let ((candidates
          (list
            (or *dictate-executable* #f)
            {File :root "Users" "cartier" "Devel" "psi-lab" "experiments" "dictation" "JediDictate.app" "Contents" "MacOS" "jedi-dictate"}
            {File :root "Users" "cartier" "Devel" "jedi" "app" "stable" "build" "stable" "JediDictate.app" "Contents" "MacOS" "jedi-dictate"})))
    (let loop ((scan candidates))
      (cond ((null? scan) #f)
            ((and (car scan) (exists? (car scan))) (car scan))
            (else (loop (cdr scan)))))))


(definition public (generate-conversation-id)
  (format "chat_{a}_{a}"
    (inexact->exact (round (current-seconds)))
    (random-integer 100000)))


(definition public (conversation-title-from-prompt prompt)
  (let* ((line (or (let ((pos (string-find prompt #\newline)))
                     (if pos (substring prompt 0 pos) prompt))
                   "Chat"))
         (trimmed (trim-whitespace line)))
    (if (> (string-length trimmed) 45)
        (string-append (substring trimmed 0 42) "...")
      (if (string=? trimmed "")
          "New Chat"
        trimmed))))


(definition public (save-conversation id title response-id messages (file #f))
  (let* ((file (or file
                   (let ((dir (find-chats-directory)))
                     (new-file dir (string-append id ".chat")))))
         (data `(conversation
                  id: ,id
                  title: ,title
                  response-id: ,response-id
                  messages: ,messages)))
    (create-directories file)
    (call-with-output-file (parse file)
      (lambda (port)
        (display ";;;==============\n" port)
        (display ";;;  Jedi AI Chat\n" port)
        (display ";;;==============\n\n" port)
        (pp data port)))
    file))


(definition public (load-conversation file)
  (let ((data (call-with-input-file (path-settings file char-encoding: 'UTF) read)))
    (if (and (pair? data) (eq? (car data) 'conversation))
        (let ((plist (cdr data)))
          (list
            (plist-ref plist id:)
            (plist-ref plist title:)
            (plist-ref plist response-id:)
            (plist-ref plist messages:)
            file))
      (error "Invalid conversation file format: {a}" file))))


(definition public (list-saved-conversations (dir #f))
  (let ((dir (or dir (find-chats-directory))))
    (if (not (exists? dir))
        '()
      (let ((files (collect-files dir (lambda (f) (extension=? (get-extension f) "chat")))))
        (let ((sorted-files (sort > files key: get-last-modification-seconds)))
          (let loop ((scan sorted-files)
                     (acc '()))
            (if (null? scan)
                (reverse acc)
              (let* ((f (car scan))
                     (chat (load-conversation f)))
                (loop (cdr scan) (cons (list f (cadr chat) (car chat)) acc))))))))))


)
