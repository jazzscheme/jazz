(module jazz.agent.test jazz


(import (jazz.agent)
        (jazz.io))


(initialize-aliases)


(display "Running jazz.agent tests...\n")
(force-output (current-output-port))

;; Test 1: ID generation
(let ((id (generate-conversation-id)))
  (assert (string? id))
  (assert (starts-with? id "chat_"))
  (display "  [PASS] generate-conversation-id\n"))

;; Test 2: Title derivation
(let ((t1 (conversation-title-from-prompt "How to use Cairo in Jazz?"))
      (t2 (conversation-title-from-prompt "First line\nSecond line\nThird line"))
      (t3 (conversation-title-from-prompt "   A very long prompt that exceeds forty-five characters and should be trimmed   ")))
  (assert (equal? t1 "How to use Cairo in Jazz?"))
  (assert (equal? t2 "First line"))
  (assert (ends-with? t3 "..."))
  (display "  [PASS] conversation-title-from-prompt\n"))

;; Test 3: Save and Load Roundtrip
(let* ((id (generate-conversation-id))
       (title "Test Conversation")
       (response-id "resp_123456789")
       (messages '((user "Hello agent!")
                   (agent "Hello human, ready to code.")))
       (saved-file (save-conversation id title response-id messages)))
  (assert (exists? saved-file))
  (let ((loaded (load-conversation saved-file)))
    (bind (loaded-id loaded-title loaded-resp-id loaded-messages f) loaded
      (assert (equal? loaded-id id))
      (assert (equal? loaded-title title))
      (assert (equal? loaded-resp-id response-id))
      (assert (equal? loaded-messages messages))
      (display "  [PASS] save-conversation and load-conversation roundtrip\n")))
  ;; Test 4: list-saved-conversations
  (let ((chats (list-saved-conversations)))
    (assert (pair? chats))
    (let ((found (find-if (lambda (c) (equal? (caddr c) id)) chats)))
      (assert found)
      (display "  [PASS] list-saved-conversations includes saved chat\n")))
  ;; Cleanup
  (delete saved-file))

(display "All jazz.agent tests passed successfully!\n")
(force-output (current-output-port))


)
