(module jazz.ai jazz


(import (jazz.io)
        (jazz.json))


(definition gemini-api-key
  (global-setting 'GEMINI_API_KEY #f))


(definition default-model
  "gemini-3.8-flash")


(definition files-url
  "https://generativelanguage.googleapis.com/upload/v1beta/files")

(definition interactions-url
  "https://generativelanguage.googleapis.com/v1beta/interactions")


;;;
;;;; Upload
;;;


(definition public (gemini-upload file (model: model #f))
  (let ((headers '("X-Goog-Upload-Protocol: raw"
                   "X-Goog-Upload-Command: upload, finalize"
                   "X-Goog-Upload-Header-Content-Type: text/plain"))
        (data (list "--data-binary" (string-append "@" (parse file)))))
    (let ((reply (call-gemini gemini-api-key model headers data files-url)))
      (table-ref (table-ref reply "file") "uri"))))


;;;
;;;; Generate
;;;


(definition public (gemini-inject uri (model: model #f) (response-id: response-id #f))
  (define (generate-payload)
    (let ((fields (list
                    (cons "model" (or model default-model))
                    (cons "input" (list (list->table (list
                                                       (cons "type" "document")
                                                       (cons "uri" uri)
                                                       (cons "mime_type" "text/plain")))
                                        (list->table (list
                                                       (cons "type" "text")
                                                       (cons "text" "System: Process this file context for a continuous conversation. Do not analyze it yet. Reply with exactly the single character '.' and nothing else."))))))))
      (when response-id
        (set! fields (cons (cons "previous_interaction_id" response-id) fields)))
      (list->table fields)))
  
  (let ((headers '("Content-Type: application/json"))
        (payload (generate-payload)))
    (let ((data (json->string payload)))
      (gemini-id (call-gemini gemini-api-key model headers (list "--data" data) interactions-url)))))


(definition public (gemini-generate prompt (model: model #f) (system: system #f) (temperature: temperature #f) (response-id: response-id #f))
  (define (generate-payload)
    (let ((fields (list
                    (cons "model" (or model default-model))
                    (cons "input" (list (list->table (list (cons "type" "text") (cons "text" prompt))))))))
      (when system
        (set! fields (cons (cons "system_instruction" system) fields)))
      (when temperature
        (set! fields (cons (cons "generation_config" (list->table (list (cons "temperature" temperature)))) fields)))
      (when response-id
        (set! fields (cons (cons "previous_interaction_id" response-id) fields)))
      (list->table fields)))
  
  (let ((headers '("Content-Type: application/json"))
        (payload (generate-payload)))
    (let ((data (json->string payload)))
      (call-gemini gemini-api-key model headers (list "--data" data) interactions-url))))


(definition public (gemini-text reply)
  (let ((err (table-ref reply "error" #f)))
    (if err
        (error "Gemini error {a}: {a}"
               (table-ref err "code" "?")
               (table-ref err "message" "unknown"))
      (let ((steps (table-ref reply "steps" '())))
        (if (null? steps)
            #f
          (let ((content (table-ref (cadr steps) "content" #f)))
            (and content
                 (table-ref (car content) "text" ""))))))))


(definition public (gemini-id reply)
  (table-ref reply "id" #f))


;;;
;;;; File
;;;


;;;
;;;; File
;;;


(definition public (gemini-resolve-file path (roots: roots #f))
  (cond ((is? path Pathname)
         path)
        ((not (string? path))
         (error "Invalid path: {s}" path))
        ((starts-with? path "/")
         (new File (tokenise-filename path)))
        (else
         (let ((active-roots (let ((available (collect-if exists? (or roots *search-roots*))))
                               (if (null? available)
                                   (list (default-workspace-root))
                                 available))))
           (let loop ((scan active-roots))
             (if (null? scan)
                 (new-file (car active-roots) (tokenise-filename path))
               (let* ((root (car scan))
                      (cand (new-file root (tokenise-filename path))))
                 (if (exists? cand)
                     cand
                   (loop (cdr scan))))))))))


(definition public (gemini-strip-code text)
  (if (and (string? text) (string-starts-with? text "```"))
      (let ((start (let ((n (string-find text #\newline)))
                     (if n (+ n 1) 0))))
        (let ((body (substring text start (string-length text))))
          (let ((trimmed (trim-trailing-whitespace body)))
            (if (string-ends-with? trimmed "```")
                (trim-trailing-whitespace (substring trimmed 0 (- (string-length trimmed) 3)))
              trimmed))))
    text))


(definition public (gemini-read-file file (offset: offset #f) (limit: limit #f) (line-numbers?: line-numbers? #t))
  (let ((target (gemini-resolve-file file)))
    (if (not (exists? target))
        (error "File does not exist: {a}" (parse target))
      (if (and (not offset) (not limit))
          (call-with-input-file (parse target) read-content-string)
        (call-with-input-file (parse target)
          (lambda (port)
            (let ((start-line (or offset 1))
                  (max-lines (or limit 100)))
              (let loop ((line-num 1)
                         (collected 0)
                         (acc '()))
                (let ((line (read-line port)))
                  (cond ((or (eof-object? line) (>= collected max-lines))
                         (join (reverse acc) "\n"))
                        ((< line-num start-line)
                         (loop (+ line-num 1) collected acc))
                        (else
                         (let ((formatted-line (if line-numbers?
                                                   (format "{a width: 6 justify: :right}| {a}" line-num line)
                                                 line)))
                           (loop (+ line-num 1)
                                 (+ collected 1)
                                 (cons formatted-line acc))))))))))))))


(definition public (gemini-write-file file content (strip-code?: strip-code? #t))
  (let ((target (gemini-resolve-file file)))
    (create-directories target)
    (call-with-output-file (parse target)
      (lambda (port)
        (display (if strip-code? (gemini-strip-code content) content) port)))
    target))


(definition public (gemini-str-replace file old-string new-string (replace-all?: replace-all? #f))
  (let ((target (gemini-resolve-file file)))
    (if (not (exists? target))
        (error "File does not exist: {a}" (parse target))
      (if (string=? old-string "")
          (error "old_string cannot be empty")
        (let ((content (call-with-input-file (parse target) read-content-string)))
          (let ((old-len (string-length old-string)))
            ;; Find all occurrences of old-string
            (let loop ((pos 0)
                       (matches '()))
              (let ((found (string-search content old-string start: pos)))
                (if (not found)
                    (let ((match-count (length matches)))
                      (cond ((= match-count 0)
                             (error "old_string not found in {a}. Ensure exact indentation and content." (parse target)))
                            ((and (> match-count 1) (not replace-all?))
                             (error "old_string occurs {a} times in {a}. Provide more surrounding context to make it unique, or set replace-all?: #t." match-count (parse target)))
                            (else
                             ;; Perform replacements
                             (let replace-loop ((scan (reverse matches))
                                                (last-end 0)
                                                (pieces '()))
                               (if (null? scan)
                                   (let* ((final-pieces (reverse (cons (substring content last-end (string-length content)) pieces)))
                                          (new-content (join-strings final-pieces "")))
                                     (call-with-output-file (parse target)
                                       (lambda (port)
                                         (display new-content port)))
                                     target)
                                 (let* ((match-start (car scan))
                                        (prefix (substring content last-end match-start)))
                                   (replace-loop (cdr scan)
                                                 (+ match-start old-len)
                                                 (cons new-string (cons prefix pieces)))))))))
                  (loop (+ found old-len) (cons found matches)))))))))))


;;;
;;;; Grep
;;;


(definition *search-roots*
  (list {Directory :root "Users" "cartier" "Devel" "psi-lab"}
        {Directory :root "Users" "cartier" "Devel" "jedi" "app" "stable"}))


(definition public (get-search-roots)
  *search-roots*)


(definition public (set-search-roots roots)
  (set! *search-roots* roots))


(definition public (gemini-grep pattern (dir: dir #f) (roots: roots #f) (max-results: max-results 100) (case-sensitive?: case-sensitive? #t))
  (let* ((active-roots (let ((available (collect-if exists? (or roots *search-roots*))))
                         (if (null? available)
                             (list (default-workspace-root))
                           available)))
         (target-dirs (cond ((not dir)
                             (map parse active-roots))
                            ((string? dir)
                             (if (starts-with? dir "/")
                                 (list dir)
                               (let loop ((scan active-roots))
                                 (if (null? scan)
                                     (list (string-append (parse (car active-roots)) "/" dir))
                                   (let* ((root (car scan))
                                          (cand-dir (new-directory root (tokenise-filename dir)))
                                          (cand-file (new-file root (tokenise-filename dir))))
                                     (cond ((exists? cand-dir)
                                            (list (parse cand-dir)))
                                           ((exists? cand-file)
                                            (list (parse cand-file)))
                                           (else
                                            (loop (cdr scan)))))))))
                            (else
                             (list (parse dir)))))
         (args `(,@(if case-sensitive? '("-rnI") '("-rnIi"))
                 "--exclude-dir=.git"
                 "--exclude-dir=build"
                 "--exclude-dir=node_modules"
                 "--exclude-dir=.chats"
                 "-e" ,(format "{a}" pattern)
                 ,@target-dirs)))
    (let ((port (open-process (list path: "grep" arguments: args show-console: #f))))
      (let loop ((count 0)
                 (lines '()))
        (let ((line (read-line port)))
          (cond ((eof-object? line)
                 (close-port port)
                 (if (null? lines)
                     (format "No matches found for '{a}'." pattern)
                   (join (reverse lines) "\n")))
                ((>= count max-results)
                 (close-port port)
                 (string-append (join (reverse lines) "\n")
                                (format "\n... (truncated at {a} matches)" max-results)))
                (else
                 (loop (+ count 1) (cons line lines)))))))))


;;;
;;;; Test Execution
;;;


(definition *jazz-binary*
  {File :root "Users" "cartier" "Devel" "jedi" "app" "stable" "build" "stable" "jazz"})


(definition public (get-jazz-binary)
  (if (exists? *jazz-binary*)
      (parse *jazz-binary*)
    "jazz"))


(definition public (set-jazz-binary path)
  (set! *jazz-binary* (if (string? path) (new File (tokenise-filename path)) path)))


(definition public (gemini-run-test product
                                    (arguments: arguments '())
                                    (repositories: repositories #f)
                                    (work-dir: work-dir #f)
                                    (max-lines: max-lines 200))
  (let* ((jazz-bin (get-jazz-binary))
         (prod-str (format "{a}" product))
         (dir (or work-dir "/Users/cartier/Devel/jedi/app/stable"))
         (repo-args (if repositories
                        (list "-repositories" (format "{a}" repositories))
                      '()))
         (extra-args (if (list? arguments) arguments '()))
         (args `("-:d-aq"
                 ,@repo-args
                 "-test"
                 ,prod-str
                 ,@extra-args)))
    (let ((port (open-process
                  (list path: jazz-bin
                        arguments: args
                        directory: dir
                        stderr-redirection: #t
                        show-console: #f))))
      (let loop ((count 0)
                 (lines '()))
        (let ((line (read-line port)))
          (cond ((eof-object? line)
                 (let ((status (process-status port)))
                   (close-port port)
                   (let* ((output (join (reverse lines) "\n"))
                          (failed? (or (/= status 0)
                                       (string-search output "*** ERROR")
                                       (string-search output "FAILED")
                                       (string-search output "failed"))))
                     (values output status (and failed? #t)))))
                ((>= count max-lines)
                 (let ((status (process-status port)))
                   (close-port port)
                   (let* ((output (string-append (join (reverse lines) "\n")
                                                 (format "\n... (truncated at {a} lines)" max-lines)))
                          (failed? (or (/= status 0)
                                       (string-search output "*** ERROR"))))
                     (values output status (and failed? #t)))))
                (else
                 (loop (+ count 1) (cons line lines)))))))))


;;;
;;;; Actions
;;;


(definition (default-workspace-root)
  {Directory :root "Users" "cartier" "Devel" "psi-lab"})


(definition public (gemini-execute-actions reply (root: root (default-workspace-root)))
  (let ((text (if (string? reply) reply (gemini-text reply))))
    (if (not (string? text))
        (error "Invalid reply text from Gemini: {s}" reply)
      (let ((clean-text (gemini-strip-code text)))
        (let ((json (string->json clean-text)))
          (let ((thought (table-ref json "thought" #f))
                (actions (table-ref json "actions" '())))
            (when thought
              (display (string-append "\nAI Thought: " thought "\n"))
              (force-output (current-output-port)))
            (map (lambda (action-table)
                   (let ((action (table-ref action-table "action" #f)))
                     (cond ((equal? action "write")
                            (let ((rel-path (table-ref action-table "path" #f))
                                  (content (table-ref action-table "content" "")))
                              (if (not rel-path)
                                  (error "Missing 'path' in write action: {s}" action-table)
                                (let ((file (new-file root (tokenise-filename rel-path))))
                                  (gemini-write-file file content)
                                  (display (string-append "Action WRITE -> " (parse file) "\n"))
                                  (force-output (current-output-port))
                                  (cons 'write (parse file))))))
                           ((equal? action "read")
                            (let ((path (table-ref action-table "path" #f))
                                  (offset (table-ref action-table "offset" #f))
                                  (limit (table-ref action-table "limit" #f))
                                  (line-numbers? (table-ref action-table "line_numbers" #t)))
                              (if (not path)
                                  (error "Missing 'path' in read action: {s}" action-table)
                                (let ((content (gemini-read-file path offset: offset limit: limit line-numbers?: line-numbers?)))
                                  (display (string-append "Action READ -> " path "\n"))
                                  (force-output (current-output-port))
                                  (cons 'read content)))))
                           ((equal? action "str_replace")
                            (let ((path (table-ref action-table "path" #f))
                                  (old-string (table-ref action-table "old_string" #f))
                                  (new-string (table-ref action-table "new_string" #f))
                                  (replace-all? (table-ref action-table "replace_all" #f)))
                              (if (or (not path) (not old-string) (not new-string))
                                  (error "Missing parameters in str_replace action: {s}" action-table)
                                (let ((target (gemini-str-replace path old-string new-string replace-all?: replace-all?)))
                                  (display (string-append "Action STR_REPLACE -> " (parse target) "\n"))
                                  (force-output (current-output-port))
                                  (cons 'str_replace (parse target))))))
                           ((equal? action "grep")
                            (let ((pattern (table-ref action-table "pattern" #f))
                                  (dir (table-ref action-table "dir" #f))
                                  (case-sensitive? (table-ref action-table "case_sensitive" #t)))
                              (if (not pattern)
                                  (error "Missing 'pattern' in grep action: {s}" action-table)
                                (let ((result (gemini-grep pattern dir: dir case-sensitive?: case-sensitive?)))
                                  (display (string-append "Action GREP -> " pattern "\n"))
                                  (force-output (current-output-port))
                                  (cons 'grep result)))))
                           ((or (equal? action "run_test") (equal? action "test"))
                            (let ((product (or (table-ref action-table "product" #f)
                                               (table-ref action-table "target" #f))))
                              (if (not product)
                                  (error "Missing 'product' in run_test action: {s}" action-table)
                                (receive (output status failed?) (gemini-run-test product)
                                  (display (string-append "Action RUN_TEST -> " (format "{a}" product) (if failed? " [FAILED]\n" " [PASSED]\n")))
                                  (force-output (current-output-port))
                                  (cons 'run_test output)))))
                           (else
                            (display (string-append "Unknown action: " (or action "?") "\n"))
                            (cons 'unknown action)))))
                 actions)))))))


;;;
;;;; ReAct Loop
;;;


(definition public default-agent-system-prompt
  (string-append
    "You are an autonomous AI coding agent operating inside JazzScheme and Jedi.\n"
    "You must ALWAYS communicate by responding ONLY with a valid JSON object. Never output text outside JSON.\n"
    "You have access to tools to search, inspect, modify, and test the codebase.\n"
    "\n"
    "Workspace search roots:\n"
    "- /Users/cartier/Devel/psi-lab (application workspace)\n"
    "- /Users/cartier/Devel/jedi/app/stable (Jedi and JazzScheme core system)\n"
    "\n"
    "Available Actions:\n"
    "1. grep: Search files using regular expressions across workspace roots.\n"
    "   Parameters: {\"action\": \"grep\", \"pattern\": \"<regex>\", \"dir\": \"<optional-subdir>\", \"case_sensitive\": true}\n"
    "2. read: Read file contents with 1-based line numbers.\n"
    "   Parameters: {\"action\": \"read\", \"path\": \"<filepath>\", \"offset\": <optional-1-based-line>, \"limit\": <optional-line-count>}\n"
    "3. str_replace: Surgically replace a unique string in a file.\n"
    "   Parameters: {\"action\": \"str_replace\", \"path\": \"<filepath>\", \"old_string\": \"<exact-unique-snippet>\", \"new_string\": \"<replacement>\", \"replace_all\": false}\n"
    "   Note: old_string MUST be unique in the file unless replace_all is true.\n"
    "4. write: Create or overwrite a file.\n"
    "   Parameters: {\"action\": \"write\", \"path\": \"<filepath>\", \"content\": \"<file-content>\"}\n"
    "5. run_test: Safely run JazzScheme product or unit tests and observe compiler/test output.\n"
    "   Parameters: {\"action\": \"run_test\", \"product\": \"<product-name>\", \"repositories\": \"<optional-repo-path>\"}\n"
    "\n"
    "Protocol:\n"
    "On every turn, you MUST respond with a single JSON object conforming to ONE of the following:\n"
    "\n"
    "If you need to use tools (search, read, edit):\n"
    "{\n"
    "  \"thought\": \"Brief explanation of your plan or reasoning\",\n"
    "  \"actions\": [\n"
    "    { \"action\": \"grep\", \"pattern\": \"...\" }\n"
    "  ]\n"
    "}\n"
    "\n"
    "If you are ready to answer the user (or no tools are needed):\n"
    "{\n"
    "  \"thought\": \"Summary of your findings or conclusion\",\n"
    "  \"answer\": \"Your comprehensive final response in Markdown format.\"\n"
    "}\n"
    "\n"
    "Rules:\n"
    "- Always verify code by searching and reading before making modifications.\n"
    "- Make targeted edits with str_replace rather than rewriting entire files when possible.\n"
    "- Output strictly a single valid JSON object."))


(definition public (gemini-find-outer-braces text)
  (and (string? text)
       (let ((first (string-find text #\{))
             (last (string-find-reversed text #\})))
         (and first last (< first last)
              (substring text first (+ last 1))))))


(definition public (gemini-parse-reply reply-or-text)
  (let ((text (if (string? reply-or-text) reply-or-text (gemini-text reply-or-text))))
    (if (not (string? text))
        (list 'answer #f "Error: empty response")
      (let* ((clean (gemini-strip-code text))
             (candidate-json (or (gemini-find-outer-braces clean)
                                 (gemini-find-outer-braces text)
                                 clean)))
        (let ((table (with-exception-catcher
                       (lambda (exc)
                         #f)
                       (lambda ()
                         (string->json candidate-json)))))
          (if (table? table)
              (let ((thought (table-ref table "thought" #f))
                    (actions (table-ref table "actions" #f))
                    (answer (table-ref table "answer" #f)))
                (cond ((and (pair? actions) (not (null? actions)))
                       (list 'actions thought actions))
                      ((string? answer)
                       (list 'answer thought answer))
                      ((string? thought)
                       (list 'answer thought thought))
                      (else
                       (list 'answer #f clean))))
            (list 'answer #f clean)))))))


(definition public (gemini-run-actions actions (root: root (default-workspace-root)))
  (map (lambda (action-table)
         (let ((action (table-ref action-table "action" #f)))
           (with-exception-catcher
             (lambda (exc)
               (list (if action (string->symbol (format "{a}" action)) 'unknown)
                     action-table
                     (format "Error: {a}" exc)
                     #t))
             (lambda ()
               (cond ((or (equal? action "grep") (equal? action "search"))
                      (let ((pattern (or (table-ref action-table "pattern" #f)
                                         (table-ref action-table "query" #f)))
                            (dir (or (table-ref action-table "dir" #f)
                                     (table-ref action-table "directory" #f)))
                            (case-sensitive? (table-ref action-table "case_sensitive" #t)))
                        (if (not pattern)
                            (list 'grep action-table "Error: Missing 'pattern' in grep action" #t)
                          (let ((result (gemini-grep pattern dir: dir case-sensitive?: case-sensitive?)))
                            (list 'grep pattern result #f)))))
                     ((or (equal? action "read") (equal? action "read_file"))
                      (let ((path (or (table-ref action-table "path" #f)
                                      (table-ref action-table "file" #f)))
                            (offset (or (table-ref action-table "offset" #f)
                                        (table-ref action-table "line" #f)
                                        (table-ref action-table "start_line" #f)))
                            (limit (table-ref action-table "limit" #f))
                            (line-numbers? (table-ref action-table "line_numbers" #t)))
                        (if (not path)
                            (list 'read action-table "Error: Missing 'path' in read action" #t)
                          (let ((content (gemini-read-file path offset: offset limit: limit line-numbers?: line-numbers?)))
                            (list 'read path content #f)))))
                     ((or (equal? action "str_replace") (equal? action "replace") (equal? action "replace_string"))
                      (let ((path (or (table-ref action-table "path" #f)
                                      (table-ref action-table "file" #f)))
                            (old-string (or (table-ref action-table "old_string" #f)
                                            (table-ref action-table "old" #f)))
                            (new-string (or (table-ref action-table "new_string" #f)
                                            (table-ref action-table "new" #f)))
                            (replace-all? (or (table-ref action-table "replace_all" #f)
                                              (table-ref action-table "replace_all?" #f))))
                        (if (or (not path) (not old-string) (not new-string))
                            (list 'str_replace action-table "Error: Missing path, old_string, or new_string in str_replace action" #t)
                          (let ((target (gemini-str-replace path old-string new-string replace-all?: replace-all?)))
                            (list 'str_replace (parse target) (format "Successfully replaced unique occurrence in {a}" (parse target)) #f)))))
                     ((or (equal? action "write") (equal? action "write_file"))
                      (let ((path (or (table-ref action-table "path" #f)
                                      (table-ref action-table "file" #f)))
                            (content (table-ref action-table "content" "")))
                        (if (not path)
                            (list 'write action-table "Error: Missing 'path' in write action" #t)
                          (let ((target (gemini-write-file path content)))
                            (list 'write (parse target) (format "Successfully wrote {a}" (parse target)) #f)))))
                     ((or (equal? action "run_test") (equal? action "test") (equal? action "run_product"))
                      (let ((product (or (table-ref action-table "product" #f)
                                         (table-ref action-table "target" #f)
                                         (table-ref action-table "name" #f)))
                            (repositories (table-ref action-table "repositories" #f))
                            (arguments (table-ref action-table "arguments" '()))
                            (work-dir (table-ref action-table "work_dir" #f)))
                        (if (not product)
                            (list 'run_test action-table "Error: Missing 'product' in run_test action" #t)
                          (receive (output status failed?) (gemini-run-test product
                                                                            repositories: repositories
                                                                            arguments: (if (list? arguments) arguments '())
                                                                            work-dir: work-dir)
                            (list 'run_test product output (and failed? #t))))))
                     (else
                      (list 'unknown action-table (format "Error: Unknown action '{a}'" action) #t)))))))
       actions))


(definition public (gemini-format-observations results)
  (let ((formatted
          (let loop ((scan results)
                     (index 1)
                     (acc '()))
            (if (null? scan)
                (reverse acc)
              (let* ((item (car scan))
                     (action (car item))
                     (target (cadr item))
                     (output (caddr item))
                     (error? (cadddr item)))
                (loop (cdr scan)
                      (+ index 1)
                      (cons (format "[Observation {a}: {a} {a}]\n{a}\n"
                                    index
                                    (if error? "ERROR in action" "action")
                                    action
                                    output)
                            acc)))))))
    (join-strings formatted "\n")))


(definition public (gemini-agent-query prompt
                                       (system: system default-agent-system-prompt)
                                       (response-id: response-id #f)
                                       (max-turns: max-turns 10)
                                       (on-thought: on-thought #f)
                                       (on-action: on-action #f)
                                       (on-observation: on-observation #f))
  (define (generate-turn current-prompt sys resp-id)
    (let ((reply (with-exception-catcher
                   (lambda (exc) #f)
                   (lambda () (gemini-generate current-prompt system: sys response-id: resp-id)))))
      (let ((err (and reply (table-ref reply "error" #f))))
        (if (or (not reply)
                (and err (equal? (table-ref err "code" #f) "malformed_tool_call")))
            ;; Auto-retry instructing model to produce strictly valid JSON
            (gemini-generate
              (string-append current-prompt "\n\n[System Note: Model output was malformed. You must respond ONLY with a valid JSON object conforming to the protocol: {\"thought\": \"...\", \"actions\": [...]} or {\"thought\": \"...\", \"answer\": \"...\"}.]")
              system: sys
              response-id: resp-id)
          reply))))

  (let loop ((turn 0)
             (current-prompt prompt)
             (current-resp-id response-id)
             (history '()))
    (let* ((reply (generate-turn current-prompt
                                 (if (= turn 0) system #f)
                                 current-resp-id))
           (text (gemini-text reply))
           (new-id (gemini-id reply)))
      (if (not (string? text))
          (values (format "Error: No response text received from Gemini") current-resp-id history)
        (let ((parsed (gemini-parse-reply text)))
          (let ((kind (car parsed))
                (thought (cadr parsed))
                (payload (caddr parsed)))
            (when (and thought on-thought)
              (on-thought thought))
            (case kind
              ((actions)
               (let ((actions-list payload))
                 (when on-action
                   (for-each on-action actions-list))
                 (let* ((action-results (gemini-run-actions actions-list))
                        (observations (gemini-format-observations action-results)))
                   (when on-observation
                     (on-observation action-results observations))
                   (if (>= (+ turn 1) max-turns)
                       ;; Force final answer turn
                       (let* ((force-prompt (string-append
                                              observations
                                              "\n\n[System Note: Maximum tool execution turns reached. Provide your final answer to the user now without any further actions.]"))
                              (final-reply (generate-turn force-prompt #f new-id))
                              (final-text (gemini-text final-reply))
                              (final-id (or (gemini-id final-reply) new-id))
                              (final-parsed (gemini-parse-reply final-text))
                              (final-answer (if (eq? (car final-parsed) 'answer)
                                                (caddr final-parsed)
                                              (gemini-strip-code final-text))))
                         (values final-answer final-id (reverse (cons (list 'final final-answer) history))))
                     (loop (+ turn 1)
                           (string-append observations "\n\nAnalyze these tool results. Respond with a JSON object with 'thought' and either 'actions' (to execute more tools) or 'answer' (to provide your final answer).")
                           new-id
                           (cons (list 'turn turn thought actions-list action-results) history))))))
              ((answer)
               (values payload new-id (reverse (cons (list 'answer payload) history)))))))))))


;;;
;;;; Curl
;;;


(definition (call-gemini api-key model headers data url)
  (let ((temp-file #f))
    (dynamic-wind
      (lambda ()
        (when (and (pair? data) (string=? (car data) "--data"))
          (set! temp-file (string-append "/tmp/gemini_payload_" (number->string (random-integer 1000000000)) ".json"))
          (call-with-output-file temp-file
            (lambda (p)
              (display (cadr data) p)))
          (set! data (list "--data-binary" (string-append "@" temp-file)))))
      (lambda ()
        (let ((port (open-process
                      (list path: "curl"
                        arguments: `("--silent"
                                     "--fail-with-body"
                                     "--request" "POST"
                                     "--header" ,(string-append "X-goog-api-key: " api-key)
                                     ,@(flatten-lists (map (lambda (header) (list "--header" header)) headers))
                                     ,@data
                                     ,url)))))
          (let ((text (read-line port #f)))
            (let ((status (process-status port)))
              (close-port port)
              (cond ((string? text)
                     (catch-exception-filter
                       (lambda (exc)
                         #t)
                       (lambda (exc)
                         (error "Gemini request failed with status {a}: {a}" status text))
                       (lambda ()
                         (string->json text))))
                    (else
                     (error "Gemini request failed with status {a}" status)))))))
      (lambda ()
        (when (and temp-file (file-exists? temp-file))
          (delete-file temp-file))))))


)

