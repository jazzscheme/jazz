(module jazz.ai jazz


(import (jazz.io)
        (jazz.json))


(definition gemini-api-key
  (global-setting 'GEMINI_API_KEY #f))


(definition default-model
  "gemini-3.8-flash")


(definition files-url
  "https://generativelanguage.googleapis.com/upload/v1beta/files")

(definition interactions-url
  "https://generativelanguage.googleapis.com/v1beta/interactions")


;;;
;;;; Upload
;;;


(definition public (gemini-upload file (model: model #f))
  (let ((headers '("X-Goog-Upload-Protocol: raw"
                   "X-Goog-Upload-Command: upload, finalize"
                   "X-Goog-Upload-Header-Content-Type: text/plain"))
        (data (list "--data-binary" (string-append "@" (parse file)))))
    (let ((reply (call-gemini gemini-api-key model headers data files-url)))
      (table-ref (table-ref reply "file") "uri"))))


;;;
;;;; Generate
;;;


(definition public (gemini-inject uri (model: model #f) (response-id: response-id #f))
  (define (generate-payload)
    (let ((fields (list
                    (cons "model" (or model default-model))
                    (cons "input" (list (list->table (list
                                                       (cons "type" "document")
                                                       (cons "uri" uri)
                                                       (cons "mime_type" "text/plain")))
                                        (list->table (list
                                                       (cons "type" "text")
                                                       (cons "text" "System: Process this file context for a continuous conversation. Do not analyze it yet. Reply with exactly the single character '.' and nothing else."))))))))
      (when response-id
        (set! fields (cons (cons "previous_interaction_id" response-id) fields)))
      (list->table fields)))
  
  (let ((headers '("Content-Type: application/json"))
        (payload (generate-payload)))
    (let ((data (json->string payload)))
      (gemini-id (call-gemini gemini-api-key model headers (list "--data" data) interactions-url)))))


(definition (gemini-string-param desc)
  (list->table (list (cons "type" "string") (cons "description" desc))))


(definition (gemini-bool-param desc)
  (list->table (list (cons "type" "boolean") (cons "description" desc))))


(definition (gemini-int-param desc)
  (list->table (list (cons "type" "integer") (cons "description" desc))))


(definition (gemini-function name description properties required)
  (list->table
    (list
      (cons "type" "function")
      (cons "name" name)
      (cons "description" description)
      (cons "parameters"
            (list->table
              (list
                (cons "type" "object")
                (cons "properties" (list->table properties))
                (cons "required" required)))))))


(definition public (gemini-agent-tools)
  (list
    (gemini-function "grep"
                     "Search file contents with a regular expression across workspace roots."
                     (list (cons "pattern" (gemini-string-param "Regular expression to search for"))
                           (cons "dir" (gemini-string-param "Optional subdirectory to limit the search")))
                     '("pattern"))
    (gemini-function "read"
                     "Read a file with 1-based line numbers. Use offset and limit for a slice."
                     (list (cons "path" (gemini-string-param "File path"))
                           (cons "offset" (gemini-int-param "Optional 1-based start line"))
                           (cons "limit" (gemini-int-param "Optional number of lines to read")))
                     '("path"))
    (gemini-function "str_replace"
                     "Replace a unique string in an existing file. old_string must match exactly, including indentation."
                     (list (cons "path" (gemini-string-param "File path"))
                           (cons "old_string" (gemini-string-param "Exact unique snippet to replace"))
                           (cons "new_string" (gemini-string-param "Replacement text"))
                           (cons "replace_all" (gemini-bool-param "If true, replace every occurrence")))
                     '("path" "old_string" "new_string"))
    (gemini-function "write"
                     "Create or overwrite a file. Prefer str_replace for existing files."
                     (list (cons "path" (gemini-string-param "File path"))
                           (cons "content" (gemini-string-param "Full file contents")))
                     '("path" "content"))
    (gemini-function "run_test"
                     "Run a JazzScheme product test or a .jazz test script. target is required. Never probe with empty values."
                     (list (cons "target" (gemini-string-param "Product name such as ai or agent, or a .jazz file path such as experiments/actions/hello.jazz")))
                     '("target"))
    (gemini-function "locate"
                     "Find files by glob basename, for example *hello.jazz or *test*.jazz."
                     (list (cons "pattern" (gemini-string-param "Glob pattern"))
                           (cons "dir" (gemini-string-param "Optional subdirectory to limit the search")))
                     '("pattern"))
    (gemini-function "list_directory"
                     "List the immediate children of a directory. Use a real path such as experiments, not '.'."
                     (list (cons "path" (gemini-string-param "Directory path")))
                     '("path"))))


(definition public (gemini-generate prompt
                                    (model: model #f)
                                    (system: system #f)
                                    (temperature: temperature #f)
                                    (effort: effort 'medium)
                                    (response-id: response-id #f)
                                    (json?: json? #t)
                                    (tools: tools #f)
                                    (on-port: on-port #f))
  (define (json-response-format)
    (list
      (list->table
        (list
          (cons "type" "text")
          (cons "mime_type" "application/json")
          (cons "schema"
                (list->table
                  (list
                    (cons "type" "OBJECT")
                    (cons "properties"
                          (list->table
                            (list
                              (cons "thought" (list->table (list (cons "type" "STRING"))))
                              (cons "answer" (list->table (list (cons "type" "STRING"))))
                              (cons "actions"
                                    (list->table
                                      (list
                                        (cons "type" "ARRAY")
                                        (cons "items"
                                              (list->table
                                                (list
                                                  (cons "type" "OBJECT")
                                                  (cons "additionalProperties" #t))))))))))
                    (cons "required" '("thought")))))))))

  (define (generate-input)
    (cond ((string? prompt)
           (list (list->table (list (cons "type" "text") (cons "text" prompt)))))
          ((list? prompt)
           prompt)
          (else
           (error "gemini-generate input must be a string or a list of input items"))))

  (define (generate-payload)
    (let ((fields (list
                    (cons "model" (or model default-model))
                    (cons "input" (generate-input)))))
      (when system
        (set! fields (cons (cons "system_instruction" system) fields)))
      (when tools
        (set! fields (cons (cons "tools" tools) fields)))
      (when (and json? (not tools))
        (set! fields (cons (cons "response_format" (json-response-format)) fields)))
      (let ((gen-config (list (cons "tool_choice" (if tools "validated" "none")))))
        (when temperature
          (set! gen-config (cons (cons "temperature" temperature) gen-config)))
        (when effort
          (let ((level (cond ((memq effort '(low "low" "LOW")) "low")
                             ((memq effort '(high "high" "HIGH")) "high")
                             ((memq effort '(minimal "minimal" "MINIMAL")) "minimal")
                             (else "medium"))))
            (set! gen-config (cons (cons "thinking_level" level) gen-config))))
        (set! fields (cons (cons "generation_config" (list->table gen-config)) fields)))
      (when response-id
        (set! fields (cons (cons "previous_interaction_id" response-id) fields)))
      (list->table fields)))
  
  (let ((headers '("Content-Type: application/json"))
        (payload (generate-payload)))
    (let ((data (json->string payload)))
      (call-gemini gemini-api-key model headers (list "--data" data) interactions-url on-port: on-port))))


(definition (gemini-as-list x)
  (cond ((not x)
         '())
        ((list? x)
         x)
        ((table? x)
         (list x))
        (else
         '())))


(definition public (gemini-reply-steps reply)
  (append (gemini-as-list (table-ref reply "steps" '()))
          (gemini-as-list (table-ref reply "outputs" '()))))


(definition public (gemini-blank-text? text)
  (or (not (string? text))
      (equal? (trim-trailing-whitespace text) "")))


(definition public (gemini-reply-summary reply)
  (format "status={a} steps={a}"
          (table-ref reply "status" "?")
          (join-strings (map (lambda (step)
                               (or (table-ref step "type" #f) "?"))
                             (gemini-reply-steps reply))
                        ",")))


(definition (gemini-function-call-step? step)
  (let ((typ (table-ref step "type" #f)))
    (or (equal? typ "function_call")
        (equal? typ "tool_call"))))


(definition (gemini-step-text step)
  (let ((direct (table-ref step "text" #f))
        (content (table-ref step "content" #f)))
    (or (and (string? direct) direct)
        (and (table? content)
             (table-ref content "text" #f))
        (and (pair? content)
             (table? (car content))
             (table-ref (car content) "text" #f)))))


(definition public (gemini-text reply)
  (let ((err (table-ref reply "error" #f)))
    (if err
        (error "Gemini error {a}: {a}"
               (table-ref err "code" "?")
               (table-ref err "message" "unknown"))
      (or (let ((out (table-ref reply "output_text" #f)))
            (and (string? out) (not (equal? out "")) out))
          (let loop ((scan (gemini-reply-steps reply))
                     (last #f))
            (if (null? scan)
                last
              (let ((step (car scan)))
                (let ((typ (table-ref step "type" #f)))
                  (loop (cdr scan)
                        (if (or (equal? typ "text")
                                (equal? typ "message")
                                (equal? typ "model_output")
                                (not typ))
                            (or (gemini-step-text step) last)
                          last))))))))))


(definition public (gemini-thought-text reply)
  (let loop ((scan (gemini-reply-steps reply))
             (acc '()))
    (if (null? scan)
        (and (pair? acc) (join-strings (reverse acc) "\n"))
      (let ((step (car scan)))
        (if (equal? (table-ref step "type" #f) "thought")
            (let ((text (or (gemini-step-text step)
                            (table-ref step "summary" #f))))
              (loop (cdr scan) (if (string? text) (cons text acc) acc)))
          (loop (cdr scan) acc))))))


(definition public (gemini-function-calls reply)
  (let loop ((scan (gemini-reply-steps reply))
             (acc '()))
    (if (null? scan)
        (reverse acc)
      (let ((step (car scan)))
        (cond ((gemini-function-call-step? step)
               (loop (cdr scan) (cons step acc)))
              (else
               (let ((content (table-ref step "content" #f)))
                 (if (not (pair? content))
                     (loop (cdr scan) acc)
                   (let inner ((items content)
                               (found acc))
                     (if (null? items)
                         (loop (cdr scan) found)
                       (if (and (table? (car items))
                                (gemini-function-call-step? (car items)))
                           (inner (cdr items) (cons (car items) found))
                         (inner (cdr items) found))))))))))))


(definition public (gemini-call->action step)
  (let ((name (table-ref step "name" #f))
        (args (table-ref step "arguments" #f)))
    (let ((pairs (cond ((table? args)
                        (table->list args))
                       ((string? args)
                        (let ((parsed (string->json args)))
                          (if (table? parsed) (table->list parsed) '())))
                       (else
                        '()))))
      (list->table (cons (cons "action" name) pairs)))))


(definition public (gemini-function-result step output)
  (let ((call-id (or (table-ref step "id" #f)
                     (table-ref step "call_id" #f))))
    (if (or (not (string? call-id)) (equal? call-id ""))
        (error "function_call missing id: {s}" (if (table? step) (table->list step) step))
      (list->table
        (list
          (cons "type" "function_result")
          (cons "name" (table-ref step "name" ""))
          (cons "call_id" call-id)
          (cons "result"
                (list
                  (list->table
                    (list
                      (cons "type" "text")
                      (cons "text" (format "{a}" output)))))))))))


(definition public (gemini-id reply)
  (table-ref reply "id" #f))


;;;
;;;; File
;;;


(definition public (gemini-resolve-file path (roots: roots #f))
  (cond ((is? path Pathname)
         path)
        ((not (string? path))
         (error "Invalid path: {s}" path))
        ((starts-with? path "/")
         (new File (tokenise-filename path)))
        (else
         (let ((active-roots (let ((available (collect-if exists? (or roots *search-roots*))))
                               (if (null? available)
                                   (list (default-workspace-root))
                                 available))))
           (let loop ((scan active-roots))
             (if (null? scan)
                 (new-file (car active-roots) (tokenise-filename path))
               (let* ((root (car scan))
                      (cand (new-file root (tokenise-filename path))))
                 (if (exists? cand)
                     cand
                   (loop (cdr scan))))))))))


(definition public (gemini-strip-code text)
  (if (and (string? text) (string-starts-with? text "```"))
      (let ((start (let ((n (string-find text #\newline)))
                     (if n (+ n 1) 0))))
        (let ((body (substring text start (string-length text))))
          (let ((trimmed (trim-trailing-whitespace body)))
            (if (string-ends-with? trimmed "```")
                (trim-trailing-whitespace (substring trimmed 0 (- (string-length trimmed) 3)))
              trimmed))))
    text))


(definition (gemini-int n)
  (cond ((not n)
         #f)
        ((integer? n)
         n)
        ((and (pair? n) (integer? (car n)))
         (car n))
        ((string? n)
         (string->number n))
        (else
         #f)))


(definition public (gemini-read-file file (offset: offset #f) (limit: limit #f) (line-numbers?: line-numbers? #t))
  (let ((target (gemini-resolve-file file)))
    (if (not (exists? target))
        (error "File does not exist: {a}" (parse target))
      (call-with-input-file (parse target)
        (lambda (port)
          (let ((start-line
                  (if (and (pair? offset) (pair? (cdr offset)) (integer? (car offset)))
                      (car offset)
                    (or (gemini-int offset) 1)))
                (max-lines
                  (if (and (pair? offset) (pair? (cdr offset)) (integer? (cadr offset)))
                      (+ 1 (- (cadr offset) (car offset)))
                    (or (gemini-int limit) 300))))
            (let loop ((line-num 1)
                       (collected 0)
                       (total-chars 0)
                       (acc '()))
              (let ((line (read-line port)))
                (cond ((or (eof-object? line)
                           (>= collected max-lines)
                           (>= total-chars 50000))
                       (join (reverse acc) "\n"))
                      ((< line-num start-line)
                       (loop (+ line-num 1) collected total-chars acc))
                      (else
                       (let* ((safe-line (if (> (string-length line) 500)
                                             (string-append (substring line 0 500) " ...")
                                           line))
                              (formatted-line (if line-numbers?
                                                  (format "{a width: 6 justify: :right}| {a}" line-num safe-line)
                                                safe-line)))
                         (loop (+ line-num 1)
                               (+ collected 1)
                               (+ total-chars (string-length formatted-line) 1)
                               (cons formatted-line acc)))))))))))))


(definition public (gemini-write-file file content (strip-code?: strip-code? #t))
  (let ((target (gemini-resolve-file file)))
    (create-directories target)
    (call-with-output-file (parse target)
      (lambda (port)
        (display (if strip-code? (gemini-strip-code content) content) port)))
    target))


(definition public (gemini-str-replace file old-string new-string (replace-all?: replace-all? #f))
  (let ((target (gemini-resolve-file file)))
    (if (not (exists? target))
        (error "File does not exist: {a}" (parse target))
      (if (string=? old-string "")
          (error "old_string cannot be empty")
        (let ((content (call-with-input-file (parse target) read-content-string)))
          (let ((old-len (string-length old-string)))
            ;; Find all occurrences of old-string
            (let loop ((pos 0)
                       (matches '()))
              (let ((found (string-search content old-string start: pos)))
                (if (not found)
                    (let ((match-count (length matches)))
                      (cond ((= match-count 0)
                             (error "old_string not found in {a}. Ensure exact indentation and content." (parse target)))
                            ((and (> match-count 1) (not replace-all?))
                             (error "old_string occurs {a} times in {a}. Provide more surrounding context to make it unique, or set replace-all?: #t." match-count (parse target)))
                            (else
                             ;; Perform replacements
                             (let replace-loop ((scan (reverse matches))
                                                (last-end 0)
                                                (pieces '()))
                               (if (null? scan)
                                   (let* ((final-pieces (reverse (cons (substring content last-end (string-length content)) pieces)))
                                          (new-content (join-strings final-pieces "")))
                                     (call-with-output-file (parse target)
                                       (lambda (port)
                                         (display new-content port)))
                                     target)
                                 (let* ((match-start (car scan))
                                        (prefix (substring content last-end match-start)))
                                   (replace-loop (cdr scan)
                                                 (+ match-start old-len)
                                                 (cons new-string (cons prefix pieces)))))))))
                  (loop (+ found old-len) (cons found matches)))))))))))


;;;
;;;; Grep
;;;


(definition *search-roots*
  (list {Directory :root "Users" "cartier" "Devel" "jedi" "app" "stable"}))


(definition public (get-search-roots)
  *search-roots*)


(definition public (set-search-roots roots)
  (set! *search-roots* roots))


(definition public (gemini-grep pattern (dir: dir #f) (roots: roots #f) (max-results: max-results 100) (case-sensitive?: case-sensitive? #t))
  (let* ((active-roots (let ((available (collect-if exists? (or roots *search-roots*))))
                         (if (null? available)
                             (list (default-workspace-root))
                           available)))
         (target-dirs (cond ((not dir)
                             (map parse active-roots))
                            ((string? dir)
                             (if (starts-with? dir "/")
                                 (list dir)
                               (let loop ((scan active-roots))
                                 (if (null? scan)
                                     (list (string-append (parse (car active-roots)) "/" dir))
                                   (let* ((root (car scan))
                                          (cand-dir (new-directory root (tokenise-filename dir)))
                                          (cand-file (new-file root (tokenise-filename dir))))
                                     (cond ((exists? cand-dir)
                                            (list (parse cand-dir)))
                                           ((exists? cand-file)
                                            (list (parse cand-file)))
                                           (else
                                            (loop (cdr scan)))))))))
                            (else
                             (list (parse dir)))))
         (args `(,@(if case-sensitive? '("-rnI") '("-rnIi"))
                 "--exclude-dir=.git"
                 "--exclude-dir=.next"
                 "--exclude-dir=build"
                 "--exclude-dir=node_modules"
                 "--exclude-dir=.chats"
                 "--exclude-dir=.cursor"
                 "--exclude-dir=.turbo"
                 "--exclude-dir=.cache"
                 "--exclude-dir=dist"
                 "--exclude-dir=.idea"
                 "--exclude=package-lock.json"
                 "--exclude=*.min.js"
                 "--exclude=*.map"
                 "--exclude=*.tsbuildinfo"
                 "-e" ,(format "{a}" pattern)
                 ,@target-dirs)))
    (let ((port (open-process (list path: "grep" arguments: args show-console: #f))))
      (let loop ((count 0)
                 (total-chars 0)
                 (lines '()))
        (let ((line (read-line port)))
          (cond ((eof-object? line)
                 (close-port port)
                 (if (null? lines)
                     (format "No matches found for '{a}'." pattern)
                   (join (reverse lines) "\n")))
                ((or (>= count max-results) (>= total-chars 30000))
                 (close-port port)
                 (string-append (join (reverse lines) "\n")
                                (format "\n... (truncated at {a} matches)" count)))
                (else
                 (let* ((truncated (if (> (string-length line) 250)
                                       (string-append (substring line 0 250) " ...")
                                     line))
                        (line-len (+ (string-length truncated) 1)))
                   (loop (+ count 1)
                         (+ total-chars line-len)
                         (cons truncated lines))))))))))


;;;
;;;; Locate
;;;


(definition public (gemini-locate pattern (dir: dir #f) (roots: roots #f) (max-results: max-results 100))
  (if (or (not pattern) (equal? pattern ""))
      (error "Missing 'pattern' in locate action")
    (let* ((active-roots (let ((available (collect-if exists? (or roots *search-roots*))))
                           (if (null? available)
                               (list (default-workspace-root))
                             available)))
           (target-dirs (cond ((not dir)
                               (map parse active-roots))
                              ((string? dir)
                               (if (starts-with? dir "/")
                                   (list dir)
                                 (let loop ((scan active-roots))
                                   (if (null? scan)
                                       (list (string-append (parse (car active-roots)) "/" dir))
                                     (let* ((root (car scan))
                                            (cand-dir (new-directory root (tokenise-filename dir)))
                                            (cand-file (new-file root (tokenise-filename dir))))
                                       (cond ((exists? cand-dir)
                                              (list (parse cand-dir)))
                                             ((exists? cand-file)
                                              (list (parse cand-file)))
                                             (else
                                              (loop (cdr scan)))))))))
                              (else
                               (list (parse dir)))))
           (name-flag (if (string-find pattern #\/) "-path" "-name"))
           (args `(,@target-dirs
                   "(" "-name" ".git" "-o" "-name" ".next" "-o" "-name" "build" "-o"
                   "-name" "node_modules" "-o" "-name" ".chats" "-o" "-name" ".cursor" "-o"
                   "-name" ".turbo" "-o" "-name" ".cache" "-o" "-name" "dist" "-o" "-name" ".idea" ")"
                   "-prune" "-o" "-type" "f" ,name-flag ,(format "{a}" pattern) "-print")))
      (let ((port (open-process (list path: "find" arguments: args show-console: #f))))
        (let loop ((count 0)
                   (lines '()))
          (let ((line (read-line port)))
            (cond ((eof-object? line)
                   (close-port port)
                   (if (null? lines)
                       (format "No files found for '{a}'." pattern)
                     (join (reverse lines) "\n")))
                  ((>= count max-results)
                   (close-port port)
                   (string-append (join (reverse lines) "\n")
                                  (format "\n... (truncated at {a} matches)" max-results)))
                  (else
                   (loop (+ count 1) (cons line lines))))))))))


;;;
;;;; List Directory
;;;


(definition public (gemini-list-directory dir (roots: roots #f) (max-results: max-results 200))
  (if (or (not dir) (equal? dir "") (equal? dir "?"))
      (error "list_directory requires 'path'")
    (let* ((dir-str (format "{a}" dir))
           (active-roots (let ((available (collect-if exists? (or roots *search-roots*))))
                           (if (null? available)
                               (list (default-workspace-root))
                             available)))
           (target (cond ((or (equal? dir-str ".") (equal? dir-str "./"))
                          (parse (car active-roots)))
                         ((starts-with? dir-str "/")
                          dir-str)
                         (else
                          (let loop ((scan active-roots))
                            (if (null? scan)
                                (string-append (parse (car active-roots)) "/" dir-str)
                              (let ((cand (new-directory (car scan) (tokenise-filename dir-str))))
                                (if (exists? cand)
                                    (parse cand)
                                  (loop (cdr scan))))))))))
      (cond ((not (file-exists? target))
             (error "Directory does not exist: {a}" target))
            ((not (eq? (file-info-type (file-info target)) 'directory))
             (error "Not a directory: {a}" target))
            (else
             (let ((args `(,target
                           "-mindepth" "1" "-maxdepth" "1"
                           "(" "-name" ".git" "-o" "-name" ".next" "-o" "-name" "build" "-o"
                           "-name" "node_modules" "-o" "-name" ".chats" "-o" "-name" ".cursor" "-o"
                           "-name" ".turbo" "-o" "-name" ".cache" "-o" "-name" "dist" "-o" "-name" ".idea" ")"
                           "-prune" "-o" "-print")))
               (let ((port (open-process (list path: "find" arguments: args show-console: #f))))
                 (let loop ((count 0)
                            (lines '()))
                   (let ((line (read-line port)))
                     (cond ((eof-object? line)
                            (close-port port)
                            (if (null? lines)
                                (format "Directory is empty: {a}" target)
                              (join (reverse lines) "\n")))
                           ((>= count max-results)
                            (close-port port)
                            (string-append (join (reverse lines) "\n")
                                           (format "\n... (truncated at {a} entries)" max-results)))
                           (else
                            (loop (+ count 1) (cons line lines)))))))))))))


;;;
;;;; Test Execution
;;;


(definition *jazz-binary*
  {File :root "Users" "cartier" "Devel" "jedi" "app" "stable" "build" "stable" "jazz"})


(definition public (get-jazz-binary)
  (if (exists? *jazz-binary*)
      (parse *jazz-binary*)
    "jazz"))


(definition public (set-jazz-binary path)
  (set! *jazz-binary* (if (string? path) (new File (tokenise-filename path)) path)))


(definition public (gemini-run-test target
                                    (arguments: arguments '())
                                    (repositories: repositories #f)
                                    (work-dir: work-dir #f)
                                    (max-lines: max-lines 200))
  (let* ((jazz-bin (get-jazz-binary))
         (target-str (format "{a}" target))
         (dir (or work-dir "/Users/cartier/Devel/jedi/app/stable"))
         (repo-args (if repositories
                        (list "-repositories" (format "{a}" repositories))
                      '()))
         (extra-args (if (list? arguments) arguments '()))
         (file-target? (or (string-ends-with? target-str ".jazz")
                           (string-ends-with? target-str ".scm")
                           (string-search target-str "/")))
         (args (if file-target?
                   (let ((resolved (gemini-resolve-file target-str)))
                     `("-:d-aq"
                       ,@repo-args
                       ,(parse resolved)
                       ,@extra-args))
                 `("-:d-aq"
                   ,@repo-args
                   "-test"
                   ,target-str
                   ,@extra-args))))
    (let ((port (open-process
                  (list path: jazz-bin
                        arguments: args
                        directory: dir
                        stderr-redirection: #t
                        show-console: #f))))
      (let loop ((count 0)
                 (lines '()))
        (let ((line (read-line port)))
          (cond ((eof-object? line)
                 (let ((status (process-status port)))
                   (close-port port)
                   (let* ((output (join (reverse lines) "\n"))
                          (failed? (or (/= status 0)
                                       (string-search output "*** ERROR")
                                       (string-search output "FAILED")
                                       (string-search output "failed"))))
                     (values output status (and failed? #t)))))
                ((>= count max-lines)
                 (let ((status (process-status port)))
                   (close-port port)
                   (let* ((output (string-append (join (reverse lines) "\n")
                                                 (format "\n... (truncated at {a} lines)" max-lines)))
                          (failed? (or (/= status 0)
                                       (string-search output "*** ERROR"))))
                     (values output status (and failed? #t)))))
                (else
                 (loop (+ count 1) (cons line lines)))))))))


;;;
;;;; Actions
;;;


(definition (default-workspace-root)
  {Directory :root "Users" "cartier" "Devel" "jedi" "app" "stable"})


(definition public (gemini-execute-actions reply (root: root (default-workspace-root)))
  (let ((text (if (string? reply) reply (gemini-text reply))))
    (if (not (string? text))
        (error "Invalid reply text from Gemini: {s}" reply)
      (let ((clean-text (gemini-strip-code text)))
        (let ((json (string->json clean-text)))
          (let ((thought (table-ref json "thought" #f))
                (actions (table-ref json "actions" '())))
            (when thought
              (display (string-append "\nAI Thought: " thought "\n"))
              (force-output (current-output-port)))
            (map (lambda (action-table)
                   (let ((action (table-ref action-table "action" #f)))
                     (cond ((equal? action "write")
                            (let ((rel-path (table-ref action-table "path" #f))
                                  (content (table-ref action-table "content" "")))
                              (if (not rel-path)
                                  (error "Missing 'path' in write action: {s}" action-table)
                                (let ((file (new-file root (tokenise-filename rel-path))))
                                  (gemini-write-file file content)
                                  (display (string-append "Action WRITE -> " (parse file) "\n"))
                                  (force-output (current-output-port))
                                  (cons 'write (parse file))))))
                           ((equal? action "read")
                            (let ((path (table-ref action-table "path" #f))
                                  (offset (table-ref action-table "offset" #f))
                                  (limit (table-ref action-table "limit" #f))
                                  (line-numbers? (table-ref action-table "line_numbers" #t)))
                              (if (not path)
                                  (error "Missing 'path' in read action: {s}" action-table)
                                (let ((content (gemini-read-file path offset: offset limit: limit line-numbers?: line-numbers?)))
                                  (display (string-append "Action READ -> " path "\n"))
                                  (force-output (current-output-port))
                                  (cons 'read content)))))
                           ((equal? action "str_replace")
                            (let ((path (table-ref action-table "path" #f))
                                  (old-string (table-ref action-table "old_string" #f))
                                  (new-string (table-ref action-table "new_string" #f))
                                  (replace-all? (table-ref action-table "replace_all" #f)))
                              (if (or (not path) (not old-string) (not new-string))
                                  (error "Missing parameters in str_replace action: {s}" action-table)
                                (let ((target (gemini-str-replace path old-string new-string replace-all?: replace-all?)))
                                  (display (string-append "Action STR_REPLACE -> " (parse target) "\n"))
                                  (force-output (current-output-port))
                                  (cons 'str_replace (parse target))))))
                           ((equal? action "grep")
                            (let ((pattern (table-ref action-table "pattern" #f))
                                  (dir (table-ref action-table "dir" #f))
                                  (case-sensitive? (table-ref action-table "case_sensitive" #t)))
                              (if (not pattern)
                                  (error "Missing 'pattern' in grep action: {s}" action-table)
                                (let ((result (gemini-grep pattern dir: dir case-sensitive?: case-sensitive?)))
                                  (display (string-append "Action GREP -> " pattern "\n"))
                                  (force-output (current-output-port))
                                  (cons 'grep result)))))
                           ((or (equal? action "run_test") (equal? action "test"))
                            (let ((product (or (table-ref action-table "product" #f)
                                               (table-ref action-table "target" #f))))
                              (if (not product)
                                  (error "Missing 'product' in run_test action: {s}" action-table)
                                (receive (output status failed?) (gemini-run-test product)
                                  (display (string-append "Action RUN_TEST -> " (format "{a}" product) (if failed? " [FAILED]\n" " [PASSED]\n")))
                                  (force-output (current-output-port))
                                  (cons 'run_test output)))))
                           (else
                            (display (string-append "Unknown action: " (or action "?") "\n"))
                            (cons 'unknown action)))))
                 actions)))))))


;;;
;;;; ReAct Loop
;;;


;;;
;;;; Agent Profiles & System Prompts
;;;


(definition public (base-agent-protocol)
  (string-append
    "Protocol:\n"
    "The runtime declares your tools with a JSON Schema. Call those functions directly. Do not wrap calls in JSON, and do not invent names.\n"
    "The declared tools are: grep, read, str_replace, write, run_test, locate, list_directory.\n"
    "To search file contents use grep. To find files by name use locate.\n"
    "\n"
    "Creating or editing files MUST be done with write or str_replace.\n"
    "Never paste source files, markdown headings of .jazz paths, or code fences of modules into the answer.\n"
    "If the files are not yet on disk, you are not done: call write or str_replace, then continue.\n"
    "When the task is complete, reply in plain text with a short summary of paths changed and test results. No source files.\n"
    "\n"
    "Tool notes:\n"
    "1. grep: pattern is required. dir is an optional subdirectory.\n"
    "2. read: path is required. offset is a 1-based start line. limit is a line count.\n"
    "3. str_replace: path, old_string, and new_string are required. old_string MUST be unique unless replace_all is true.\n"
    "4. write: path and content are required. Prefer str_replace for existing files.\n"
    "5. run_test: target is REQUIRED. Use a product name (ai, agent) or a .jazz file path such as experiments/actions/hello.jazz.\n"
    "   Never call run_test without target, and never use placeholders like \"?\" or \"\".\n"
    "6. locate: pattern is a glob such as *hello.jazz. dir is optional.\n"
    "7. list_directory: path is required. Use a real path such as experiments, not \".\".\n"
    "\n"
    "Workspace search roots:\n"
    "- /Users/cartier/Devel/jedi/app/stable (Jedi and JazzScheme core system)\n"))


(definition public (coding-agent-system-prompt)
  (string-append
    "You are a Principal Software Engineer specializing in JazzScheme, Gambit Scheme, and the Jedi IDE.\n"
    "Your goal is to autonomously develop, inspect, test, and maintain JazzScheme applications with rigorous engineering discipline.\n"
    "Use the declared tools to inspect, edit, and test. Reply in plain text only when the task is done.\n"
    "\n"
    "=== ENGINEERING GUIDELINES ===\n"
    "1. Investigation First (Never Guess APIs):\n"
    "   - Before using a JazzScheme class, method, or macro (such as View, draw-background, Cairo procedures, event handlers), use `grep` or `read` in `/Users/cartier/Devel/jedi/app/stable` to inspect actual definitions and usage patterns.\n"
    "   - Trace symbols back to their definitions. Never guess or hallucinate JazzScheme APIs.\n"
    "\n"
    "2. Test-Driven Self-Correction Loop:\n"
    "   - Never assume written code works. Always run `run_test` with an explicit target (product name such as ai/agent, or a .jazz test file path).\n"
    "   - Never call a tool with missing required parameters or placeholders (\"?\", \"\") to discover its signature. Read this protocol or grep the implementation instead.\n"
    "   - If `run_test` outputs an error (e.g. unbound variable, syntax error, failed assertion), carefully analyze the compiler/runtime backtrace, locate the faulty code, use `str_replace` to apply a surgical fix, and re-run `run_test` until all tests pass.\n"
    "   - Only present your final answer once tests pass or you have verified the solution.\n"
    "\n"
    "3. Surgical Code Editing (Cursor Contract):\n"
    "   - Prefer `str_replace` over `write` for existing files.\n"
    "   - In `str_replace`, provide sufficient surrounding lines in `old_string` to guarantee it is unique in the file.\n"
    "   - Preserve exact indentation (tabs/spaces) as found in the existing code.\n"
    "\n"
    "4. JazzScheme Idioms & Structure:\n"
    "   - Every JazzScheme module must have the standard header:\n"
    "       ;;;==============\n"
    "       ;;;  JazzScheme\n"
    "       ;;;==============\n"
    "       ;;;\n"
    "       ;;;; <Title>\n"
    "       ;;;\n"
    "       (module <module.name> jazz\n"
    "         (import ...)\n"
    "         ...)\n"
    "   - Use idiomatic class definitions: `(class <Name> extends <Super> ...)`, `(slot <name> initialize <val> accessors generate)`, `(method override (<name> self ...) ...)`, and `(property <name> initialize <val> accessors generate)`.\n"
    "   - When creating packages, properly define `.package` with `title`, `stage`, `root`, `products` (including `run`, `test`, `update`, `dependencies`), and reference `.project`.\n"
    "\n"
    (base-agent-protocol)))


(definition public (assistant-agent-system-prompt)
  (string-append
    "You are an AI assistant and expert guide for JazzScheme and the Jedi IDE.\n"
    "You explain concepts clearly, answer architecture questions, provide code snippets, and help users navigate the codebase.\n"
    "Use the declared tools to verify facts before answering. Reply in plain text when you are done.\n"
    "\n"
    (base-agent-protocol)))


(definition *agent-profiles*
  '())


(definition public (register-agent-profile name prompt)
  (set! *agent-profiles* (cons (cons name prompt) *agent-profiles*)))


(definition public (get-agent-system-prompt (profile 'coder))
  (cond ((assq profile *agent-profiles*)
         => cdr)
        ((eq? profile 'coder)
         (coding-agent-system-prompt))
        ((eq? profile 'assistant)
         (assistant-agent-system-prompt))
        (else
         (coding-agent-system-prompt))))


(definition public default-agent-system-prompt
  (coding-agent-system-prompt))


(definition public (gemini-find-outer-braces text)
  (and (string? text)
       (let ((first (string-find text #\{))
             (last (string-find-reversed text #\})))
         (and first last (< first last)
              (substring text first (+ last 1))))))


(definition public (gemini-parse-reply reply-or-text)
  (let ((text (if (string? reply-or-text) reply-or-text (gemini-text reply-or-text))))
    (if (not (string? text))
        (list 'answer #f "Error: empty response")
      (let* ((clean (gemini-strip-code text))
             (candidate (or (gemini-find-outer-braces clean)
                            (gemini-find-outer-braces text))))
        (if candidate
            (let ((table (string->json candidate)))
              (let ((thought (table-ref table "thought" #f))
                    (actions (table-ref table "actions" #f))
                    (answer (table-ref table "answer" #f)))
                (cond ((and (pair? actions) (not (null? actions)))
                       (list 'actions thought actions))
                      ((string? answer)
                       (list 'answer thought answer))
                      ((string? thought)
                       (list 'answer thought thought))
                      (else
                       (list 'answer #f clean)))))
          (list 'answer #f clean))))))


(definition (gemini-optional-dir dir)
  (if (or (not dir)
          (equal? dir "")
          (equal? dir ".")
          (equal? dir "./")
          (equal? dir "?"))
      #f
    dir))


(definition public (gemini-answer-is-file-dump? text)
  (and (string? text)
       (or (and (string-search text "```")
                (string-search text "(module "))
           (and (or (string-search text "### ")
                    (string-search text "## "))
                (string-search text ".jazz")))))


(definition public (gemini-run-action action-table (root: root (default-workspace-root)))
  (let ((action (table-ref action-table "action" #f)))
    (cond ((equal? action "grep")
           (let ((pattern (table-ref action-table "pattern" #f))
                 (dir (gemini-optional-dir (table-ref action-table "dir" #f)))
                 (case-sensitive? (table-ref action-table "case_sensitive" #t)))
             (if (not pattern)
                 (error "Missing 'pattern' in grep action: {s}" (table->list action-table))
               (let ((result (gemini-grep pattern dir: dir case-sensitive?: case-sensitive?)))
                 (list 'grep pattern result)))))
          ((equal? action "locate")
           (let ((pattern (table-ref action-table "pattern" #f))
                 (dir (gemini-optional-dir (table-ref action-table "dir" #f))))
             (if (not pattern)
                 (error "Missing 'pattern' in locate action: {s}" (table->list action-table))
               (let ((result (gemini-locate pattern dir: dir)))
                 (list 'locate pattern result)))))
          ((equal? action "list_directory")
           (let ((path (table-ref action-table "path" #f)))
             (if (not path)
                 (error "Missing 'path' in list_directory action: {s}" (table->list action-table))
               (let ((result (gemini-list-directory path)))
                 (list 'list_directory path result)))))
          ((equal? action "read")
           (let ((path (table-ref action-table "path" #f))
                 (offset (table-ref action-table "offset" #f))
                 (limit (table-ref action-table "limit" #f))
                 (line-numbers? (table-ref action-table "line_numbers" #t)))
             (if (not path)
                 (error "Missing 'path' in read action: {s}" (table->list action-table))
               (let ((content (gemini-read-file path offset: offset limit: limit line-numbers?: line-numbers?)))
                 (list 'read path content)))))
          ((equal? action "str_replace")
           (let ((path (table-ref action-table "path" #f))
                 (old-string (table-ref action-table "old_string" #f))
                 (new-string (table-ref action-table "new_string" #f))
                 (replace-all? (table-ref action-table "replace_all" #f)))
             (if (or (not path) (not old-string) (not new-string))
                 (error "Missing parameters in str_replace action: {s}" (table->list action-table))
               (let ((target (gemini-str-replace path old-string new-string replace-all?: replace-all?)))
                 (list 'str_replace (parse target) (format "Successfully replaced unique occurrence in {a}" (parse target)))))))
          ((equal? action "write")
           (let ((path (table-ref action-table "path" #f))
                 (content (table-ref action-table "content" #f)))
             (if (not path)
                 (error "Missing 'path' in write action: {s}" (table->list action-table))
               (let ((target (gemini-write-file path (or content ""))))
                 (list 'write (parse target) (format "Successfully wrote {a}" (parse target)))))))
          ((equal? action "run_test")
           (let ((product (or (table-ref action-table "target" #f)
                              (table-ref action-table "product" #f)))
                 (repositories (table-ref action-table "repositories" #f))
                 (arguments (table-ref action-table "arguments" '()))
                 (work-dir (table-ref action-table "work_dir" #f)))
             (if (or (not product) (equal? product "") (equal? product "?"))
                 (error "run_test requires 'target': a product name (e.g. ai, agent) or a .jazz file path. Got: {s}" (table->list action-table))
               (receive (output status failed?) (gemini-run-test product
                                                                 repositories: repositories
                                                                 arguments: (if (list? arguments) arguments '())
                                                                 work-dir: work-dir)
                 (list 'run_test product output)))))
          (else
           (error "Unknown action '{a}': {s}" action (table->list action-table))))))


(definition public (gemini-run-actions actions (root: root (default-workspace-root)))
  (map (lambda (action-table)
         (gemini-run-action action-table root: root))
       actions))


(definition public (gemini-format-observations results)
  (let ((formatted
          (let loop ((scan results)
                     (index 1)
                     (acc '()))
            (if (null? scan)
                (reverse acc)
              (let* ((item (car scan))
                     (action (car item))
                     (target (cadr item))
                     (output (caddr item)))
                (loop (cdr scan)
                      (+ index 1)
                      (cons (format "[Observation {a}: action {a}]\n{a}\n"
                                    index
                                    action
                                    output)
                            acc)))))))
    (join-strings formatted "\n")))


(definition public (gemini-user-input text)
  (list->table
    (list
      (cons "type" "user_input")
      (cons "content"
            (list (list->table (list (cons "type" "text") (cons "text" text))))))))


(definition public (gemini-model-output text)
  (list->table
    (list
      (cons "type" "model_output")
      (cons "content"
            (list (list->table (list (cons "type" "text") (cons "text" text))))))))


(definition public (gemini-messages->interaction-input messages prompt)
  (let loop ((scan messages)
             (acc '()))
    (if (null? scan)
        (let ((final-item
                (if (string? prompt)
                    (gemini-user-input prompt)
                  prompt)))
          (reverse (cons final-item acc)))
      (let* ((msg (car scan))
             (role (car msg))
             (text (cadr msg)))
        (cond ((eq? role 'user)
               (loop (cdr scan) (cons (gemini-user-input text) acc)))
              ((or (eq? role 'agent) (eq? role 'model) (eq? role 'assistant))
               (loop (cdr scan) (cons (gemini-model-output text) acc)))
              (else
               (loop (cdr scan) acc)))))))


(definition public (gemini-agent-query prompt
                                       (system: system default-agent-system-prompt)
                                       (response-id: response-id #f)
                                       (history: history '())
                                       (effort: effort 'medium)
                                       (max-turns: max-turns 25)
                                       (yield-to: yield-to #f)
                                       (cancelled?: cancelled? #f)
                                       (on-port: on-port #f)
                                       (on-complete: on-complete #f)
                                       (on-status: on-status #f)
                                       (on-thought: on-thought #f)
                                       (on-action: on-action #f)
                                       (on-observation: on-observation #f))
  (define (generate-turn current-prompt sys resp-id (use-tools?: use-tools? #t))
    (gemini-generate current-prompt
                     system: sys
                     response-id: resp-id
                     effort: effort
                     json?: #f
                     tools: (if use-tools? (gemini-agent-tools) #f)
                     on-port: on-port))

  (define (check-cancelled)
    (when (and cancelled? (cancelled?))
      (error "Query cancelled")))

  (define (call-yield k)
    (check-cancelled)
    ((or yield-to (lambda (cont) (cont))) k))

  (define (finish answer id hist)
    (let ((out-hist (reverse hist)))
      (when on-complete
        (on-complete answer id out-hist))
      (values answer id out-hist)))

  (define (complete-answer payload id hist)
    (if (gemini-answer-is-file-dump? payload)
        (error "Protocol error: source was dumped in the answer instead of using write/str_replace. Files were not saved.")
      (finish payload id hist)))

  (define (run-calls calls turn thought new-id hist continue)
    (check-cancelled)
    (let loop-actions ((scan calls)
                       (acc '()))
      (if (null? scan)
          (let ((pairs (reverse acc)))
            (let ((next-input (map (lambda (pair)
                                     (gemini-function-result (cadr pair) (caddr (car pair))))
                                   pairs))
                  (action-results (map car pairs)))
              (if (>= (+ turn 1) max-turns)
                  (begin
                    (when on-status
                      (on-status "Thinking..."))
                    (call-yield
                      (lambda ()
                        (check-cancelled)
                        (let* ((final-input (append next-input
                                                    (list (list->table
                                                            (list (cons "type" "text")
                                                                  (cons "text" "Maximum tool turns reached. Answer the user now in plain text. Do not call tools."))))))
                               (final-reply (generate-turn final-input #f new-id use-tools?: #f))
                               (final-text (gemini-text final-reply)))
                          (if (or (pair? (gemini-function-calls final-reply))
                                  (gemini-blank-text? final-text))
                              (error "No final answer after max turns ({a})" (gemini-reply-summary final-reply))
                            (complete-answer final-text
                                             (or (gemini-id final-reply) new-id)
                                             (cons (list 'final final-text) hist)))))))
                (continue (+ turn 1)
                          next-input
                          new-id
                          (cons (list 'turn turn thought calls action-results) hist)))))
        (let ((step (car scan))
              (action-table (gemini-call->action (car scan))))
          (check-cancelled)
          (when on-action
            (on-action action-table))
          (call-yield
            (lambda ()
              (check-cancelled)
              (let ((item (gemini-run-action action-table)))
                (check-cancelled)
                (when on-observation
                  (on-observation item (caddr item)))
                (loop-actions (cdr scan) (cons (list item step) acc)))))))))

  (let loop ((turn 0)
             (current-prompt
               (if (and (not response-id) (pair? history))
                   (gemini-messages->interaction-input history prompt)
                 prompt))
             (current-resp-id response-id)
             (trace-history '()))
    (check-cancelled)
    (when on-status
      (on-status "Thinking..."))
    (call-yield
      (lambda ()
        (check-cancelled)
        (let* ((initial-reply (generate-turn current-prompt
                                             (if (= turn 0) system #f)
                                             current-resp-id))
               (err (table-ref initial-reply "error" #f))
               (reply
                 (if (and err (= turn 0) current-resp-id (pair? history))
                     (begin
                       (set! current-resp-id #f)
                       (set! current-prompt (gemini-messages->interaction-input history prompt))
                       (check-cancelled)
                       (generate-turn current-prompt system #f))
                   initial-reply))
               (new-id (or (gemini-id reply) current-resp-id))
               (status (table-ref reply "status" #f))
               (calls (gemini-function-calls reply))
               (thought (gemini-thought-text reply))
               (text (gemini-text reply)))
          (check-cancelled)
          (when (or (equal? status "failed") (equal? status "cancelled"))
            (error "Gemini interaction {a} ({a})" status (gemini-reply-summary reply)))
          (when (and thought on-thought)
            (on-thought thought))
          (cond ((pair? calls)
                 (run-calls calls turn thought new-id trace-history loop))
                ((not (gemini-blank-text? text))
                 (complete-answer text new-id (cons (list 'answer text) trace-history)))
                ((equal? status "requires_action")
                 (error "Gemini requires_action but no function_call steps ({a})" (gemini-reply-summary reply)))
                (else
                 (error "No response text or function call received from Gemini ({a})" (gemini-reply-summary reply))))))))
)


;;;
;;;; Curl
;;;


(definition (call-gemini api-key model headers data url (on-port: on-port #f))
  (let ((temp-file #f)
        (curl-port #f))
    (dynamic-wind
      (lambda ()
        (when (and (pair? data) (string=? (car data) "--data"))
          (set! temp-file (string-append "/tmp/gemini_payload_" (number->string (random-integer 1000000000)) ".json"))
          (call-with-output-file temp-file
            (lambda (p)
              (display (cadr data) p)))
          (set! data (list "--data-binary" (string-append "@" temp-file)))))
      (lambda ()
        (let ((port (open-process
                      (list path: "curl"
                        arguments: `("--silent"
                                     "--fail-with-body"
                                     "--request" "POST"
                                     "--header" ,(string-append "X-goog-api-key: " api-key)
                                     ,@(flatten-lists (map (lambda (header) (list "--header" header)) headers))
                                     ,@data
                                     ,url)))))
          (set! curl-port port)
          (when on-port
            (on-port port))
          (let ((text (read-line port #f)))
            (let ((status (process-status port)))
              (close-port port)
              (set! curl-port #f)
              (when on-port
                (on-port #f))
              (unless (= status 0)
                (error "Gemini request failed with status {a}: {a}" status (or text "")))
              (if (string? text)
                  (string->json text)
                (error "Gemini returned empty response"))))))
      (lambda ()
        (when curl-port
          (close-port curl-port)
          (set! curl-port #f))
        (when on-port
          (on-port #f))
        (when (and temp-file (file-exists? temp-file))
          (delete-file temp-file))))))


)

