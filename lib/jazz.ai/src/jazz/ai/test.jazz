(module jazz.ai.test jazz


(import (jazz.ai)
        (jazz.io)
        (jazz.json))


(initialize-aliases)


(let* ((spec-file {File :root "Users" "cartier" "Devel" "psi-lab" "docs" "hunch-spec.md"})
       (spec (gemini-read-file spec-file))
       (prompt (string-append
                 "You are an expert JazzScheme programmer.\n"
                 "Below is the complete specification for the Hunch desktop game.\n\n"
                 spec "\n\n"
                 "Implement the entire Hunch game as a native desktop application in JazzScheme.\n"
                 "Generate only complete, runnable JazzScheme code with all required imports, widgets, canvas drawing, and rules.\n"))
       (output-file {File :root "Users" "cartier" "Devel" "psi-lab" "experiments" "ground-0" "hunch.jazz"}))
  (display "Reading spec and generating Ground 0 Hunch application...\n")
  (force-output (current-output-port))
  (let ((reply (gemini-generate prompt)))
    (let ((text (gemini-text reply)))
      (gemini-write-file output-file text)
      (display (string-append "Ground 0 written to " (parse output-file) "\n"))
      (force-output (current-output-port))))))


