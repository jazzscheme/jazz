(module jazz.ai.test jazz


(import (jazz.ai)
        (jazz.io)
        (jazz.json))


(initialize-aliases)


(display "Running jazz.ai tests...\n")
(force-output (current-output-port))

;; Test 1: Direct gemini-grep across search roots
(let ((matches (gemini-grep "Agent-Text-View extends")))
  (assert (string? matches))
  (assert (string-search matches "Agent-Text-View.jazz"))
  (display "  [PASS] gemini-grep across search roots\n"))

;; Test 2: Scoped gemini-grep in relative directory
(let ((matches (gemini-grep "gemini-generate" dir: "jazz/lib/jazz.ai")))
  (assert (string? matches))
  (assert (string-search matches "_ai.jazz"))
  (display "  [PASS] gemini-grep in scoped directory\n"))

;; Test 2b: gemini-locate by glob
(let ((matches (gemini-locate "*hello.jazz")))
  (assert (string? matches))
  (assert (string-search matches "hello.jazz"))
  (display "  [PASS] gemini-locate by glob\n"))

;; Test 2c: gemini-list-directory
(let ((listing (gemini-list-directory "experiments/actions")))
  (assert (string? listing))
  (assert (string-search listing "hello.jazz"))
  (display "  [PASS] gemini-list-directory\n"))
(let ((results (gemini-run-actions (list (list->table (list (cons "action" "list_directory")
                                                           (cons "path" "experiments")))))))
  (assert (= (length results) 1))
  (assert (eq? (caar results) 'list_directory))
  (assert (string-search (caddar results) "actions"))
  (display "  [PASS] gemini-run-actions with list_directory\n"))

;; Test 2d: native function_call steps map onto action tables
(let ((action (gemini-call->action
                (list->table
                  (list (cons "type" "function_call")
                        (cons "name" "grep")
                        (cons "id" "call-1")
                        (cons "arguments" (list->table (list (cons "pattern" "default-model")))))))))
  (assert (equal? (table-ref action "action") "grep"))
  (assert (equal? (table-ref action "pattern") "default-model"))
  (display "  [PASS] gemini-call->action\n"))

;; Test 2e: gemini-agent-tools schema declaration and gemini-function-result formatting
(let ((tools (gemini-agent-tools))
      (result (gemini-function-result
                (list->table (list (cons "name" "grep") (cons "id" "call-1")))
                "ok")))
  (assert (pair? tools))
  (let ((run-test (let loop ((scan tools))
                    (cond ((null? scan)
                           #f)
                          ((equal? (table-ref (car scan) "name" #f) "run_test")
                           (car scan))
                          (else
                           (loop (cdr scan)))))))
    (assert (table? run-test))
    (assert (equal? (table-ref (table-ref run-test "parameters") "required") '("target"))))
  (assert (equal? (table-ref result "type") "function_result"))
  (assert (equal? (table-ref result "call_id") "call-1"))
  (display "  [PASS] gemini-agent-tools and gemini-function-result\n"))

;; Test 2f: blank text detection, nested function calls, and missing call id failure
(assert (gemini-blank-text? #f))
(assert (gemini-blank-text? ""))
(assert (gemini-blank-text? "  \n"))
(assert (not (gemini-blank-text? "ok")))
(let ((reply (list->table
               (list (cons "status" "requires_action")
                     (cons "steps"
                           (list (list->table
                                   (list (cons "type" "model_output")
                                         (cons "content"
                                               (list (list->table
                                                       (list (cons "type" "function_call")
                                                             (cons "name" "read")
                                                             (cons "id" "call-2")
                                                             (cons "arguments"
                                                                   (list->table
                                                                     (list (cons "path" "x.jazz")))))))))))))))
      (failed-id? #f))
  (assert (equal? (gemini-reply-summary reply) "status=requires_action steps=model_output"))
  (let ((calls (gemini-function-calls reply)))
    (assert (= (length calls) 1))
    (assert (equal? (table-ref (car calls) "name") "read")))
  (with-exception-catcher
    (lambda (exc)
      (set! failed-id? #t))
    (lambda ()
      (gemini-function-result (list->table (list (cons "name" "grep"))) "ok")))
  (assert failed-id?))
(display "  [PASS] gemini-blank-text? nested function_call and missing call id\n")

;; Test 3: Structured action execution with GREP
(let* ((json-payload "{\n  \"thought\": \"Find definition of Agent-Text-View\",\n  \"actions\": [\n    {\n      \"action\": \"grep\",\n      \"pattern\": \"Agent-Text-View extends\"\n    }\n  ]\n}")
       (results (gemini-execute-actions json-payload)))
  (assert (pair? results))
  (assert (eq? (caar results) 'grep))
  (assert (string-search (cdar results) "Agent-Text-View.jazz"))
  (display "  [PASS] gemini-execute-actions with GREP\n"))

;; Test 4: gemini-read-file with line numbers and ranges
(let* ((test-file {File :root "Users" "cartier" "Devel" "psi-lab" "experiments" "actions" "hello.jazz"})
       (content (gemini-read-file test-file offset: 1 limit: 2)))
  (assert (string? content))
  (assert (string-search content "1|"))
  (display "  [PASS] gemini-read-file with offset and limit\n"))

;; Test 5: gemini-str-replace uniqueness contract and replacement
(let* ((temp-dir {Directory :root "Users" "cartier" "Devel" "psi-lab" ".chats"})
       (temp-file (new-file temp-dir "test_replace.txt")))
  (gemini-write-file temp-file "line 1\nreplace_me\nline 3\n")
  ;; Replace single unique occurrence
  (gemini-str-replace temp-file "replace_me" "replaced_successfully")
  (let ((updated (gemini-read-file temp-file)))
    (assert (string-search updated "replaced_successfully"))
    (assert (not (string-search updated "replace_me"))))
  ;; Non-unique without replace-all should raise error
  (gemini-write-file temp-file "dup\ndup\n")
  (let ((error-thrown? #f))
    (with-exception-catcher
      (lambda (exc)
        (set! error-thrown? #t))
      (lambda ()
        (gemini-str-replace temp-file "dup" "one")))
    (assert error-thrown?))
  ;; Clean up temp file
  (delete temp-file)
  (display "  [PASS] gemini-str-replace with uniqueness contract\n"))

;; Test 6: Live Gemini prompt generation with WRITE action
(let* ((prompt (string-append
                 "You are an autonomous AI coding agent operating inside JazzScheme.\n"
                 "You must respond with a JSON object conforming strictly to this format:\n"
                 "{\n"
                 "  \"thought\": \"Brief explanation of what you are writing\",\n"
                 "  \"actions\": [\n"
                 "    {\n"
                 "      \"action\": \"write\",\n"
                 "      \"path\": \"experiments/actions/hello.jazz\",\n"
                 "      \"content\": \";;; Hello from Gemini Action System\\n(module hello jazz\\n  (display \\\"Hello from JazzScheme!\\\\n\\\"))\\n\"\n"
                 "    }\n"
                 "  ]\n"
                 "}\n"
                 "Please create a sample hello world module in 'experiments/actions/hello.jazz'.")))
  (display "Sending structured prompt with JSON response format...\n")
  (force-output (current-output-port))
  (let ((reply (gemini-generate prompt)))
    (let ((results (gemini-execute-actions reply)))
      (display "Executed actions result: ")
      (pp results)
      (force-output (current-output-port)))))

;; Test 7: gemini-find-outer-braces and gemini-parse-reply
(let ((raw-actions "Here is my plan:\n```json\n{\n  \"thought\": \"Locate Agent-Text-View\",\n  \"actions\": [{\"action\": \"grep\", \"pattern\": \"Agent-Text-View\"}]\n}\n```\nHope that helps!")
      (raw-answer "```json\n{\n  \"thought\": \"Found answer\",\n  \"answer\": \"It is in Agent-Text-View.jazz\"\n}\n```")
      (raw-plain "Hello world, pure text!"))
  (bind (k1 t1 p1) (gemini-parse-reply raw-actions)
    (assert (eq? k1 'actions))
    (assert (equal? t1 "Locate Agent-Text-View"))
    (assert (pair? p1)))
  (bind (k2 t2 p2) (gemini-parse-reply raw-answer)
    (assert (eq? k2 'answer))
    (assert (equal? t2 "Found answer"))
    (assert (equal? p2 "It is in Agent-Text-View.jazz")))
  (bind (k3 t3 p3) (gemini-parse-reply raw-plain)
    (assert (eq? k3 'answer))
    (assert (equal? p3 "Hello world, pure text!")))
  (display "  [PASS] gemini-find-outer-braces and gemini-parse-reply\n"))

;; Test 8: gemini-run-actions and gemini-format-observations (errors fail loudly)
(let* ((actions-table (list (list->table (list (cons "action" "grep") (cons "pattern" "gemini-agent-query")))))
       (results (gemini-run-actions actions-table)))
  (assert (= (length results) 1))
  (let ((r1 (car results)))
    (assert (eq? (car r1) 'grep)))
  (let ((obs (gemini-format-observations results)))
    (assert (string-search obs "[Observation 1: action grep]")))
  ;; Verify that an invalid action / missing file halts immediately by throwing an error
  (let ((failed? #f))
    (with-exception-catcher
      (lambda (exc) (set! failed? #t))
      (lambda ()
        (gemini-run-actions (list (list->table (list (cons "action" "read") (cons "path" "nonexistent_file_xyz.jazz")))))))
    (assert failed?))
  (display "  [PASS] gemini-run-actions and gemini-format-observations\n"))

;; Test 8b: gemini-messages->interaction-input converts chat history into structured multi-turn input
(let* ((history '((user "My favorite color is emerald green.")
                  (agent "Got it! Emerald green.")
                  (user "What was my favorite color?")))
       (input (gemini-messages->interaction-input history "Also, what fruit is yellow?")))
  (assert (= (length input) 4))
  (assert (equal? (table-ref (car input) "type" #f) "user_input"))
  (assert (equal? (table-ref (cadr input) "type" #f) "model_output"))
  (assert (equal? (table-ref (caddr input) "type" #f) "user_input"))
  (assert (equal? (table-ref (cadddr input) "type" #f) "user_input"))
  (display "  [PASS] gemini-messages->interaction-input structure\n"))

;; Test 9: Live autonomous ReAct loop query
(display "Testing live autonomous ReAct loop query with gemini-agent-query...\n")
(force-output (current-output-port))
(receive (answer final-resp-id history)
    (gemini-agent-query
      "What is the exact string value of default-model defined in jazz.ai? Search for it and tell me."
      max-turns: 5
      on-status:
      (lambda (st)
        (display (string-append "  " st "\n"))
        (force-output (current-output-port)))
      on-thought:
      (lambda (th)
        (display (string-append "  Agent Thought: " th "\n"))
        (force-output (current-output-port)))
      on-action:
      (lambda (ac)
        (display (string-append "  Agent Tool Call: " (table-ref ac "action" "?") "\n"))
        (force-output (current-output-port)))
      on-observation:
      (lambda (item output)
        (display (string-append "  Agent Observation (" (format "{a}" (car item)) "):\n"))
        (display output)
        (newline)
        (force-output (current-output-port))))
  (assert (string? answer))
  (assert (string-search answer "gemini-3.8-flash"))
  (assert (string? final-resp-id))
  (display "  Agent Final Answer:\n")
  (display answer)
  (newline)
  (display "  [PASS] Live ReAct loop query\n")
  (force-output (current-output-port)))

;; Test 10: gemini-run-test and structured RUN_TEST action
(display "Testing gemini-run-test on 'agent'...\n")
(force-output (current-output-port))
(receive (output status failed?) (gemini-run-test 'agent)
  (assert (= status 0))
  (assert (not failed?))
  (assert (string-search output "All jazz.agent tests passed successfully!"))
  (display "  [PASS] gemini-run-test 'agent'\n"))

(let* ((action-table (list (list->table (list (cons "action" "run_test") (cons "product" "agent")))))
       (results (gemini-run-actions action-table)))
  (assert (= (length results) 1))
  (let ((r (car results)))
    (assert (eq? (car r) 'run_test))
    (assert (string-search (caddr r) "All jazz.agent tests passed successfully!")))
  (display "  [PASS] gemini-run-actions with RUN_TEST\n"))

;; Test 10a: missing run_test target is a loud error
(let ((failed? #f))
  (with-exception-catcher
    (lambda (exc)
      (set! failed? #t))
    (lambda ()
      (gemini-run-actions (list (list->table (list (cons "action" "run_test")
                                                   (cons "test_name" "")))))))
  (assert failed?)
  (display "  [PASS] gemini-run-actions missing run_test target fails loud\n"))

;; Test 10b: gemini-run-test executing a script file directly
(receive (out stat fail?) (gemini-run-test "experiments/actions/hello.jazz")
  (assert (= stat 0))
  (assert (not fail?))
  (assert (string-search out "Hello from JazzScheme!"))
  (display "  [PASS] gemini-run-test with direct script file\n"))

;; Test 11: Modular agent profiles and system prompts
(let ((coder-prompt (get-agent-system-prompt 'coder))
      (asst-prompt (get-agent-system-prompt 'assistant)))
  (assert (string? coder-prompt))
  (assert (string-search coder-prompt "Principal Software Engineer"))
  (assert (string-search coder-prompt "Test-Driven Self-Correction Loop"))
  (assert (string? asst-prompt))
  (assert (string-search asst-prompt "expert guide for JazzScheme"))
  ;; Custom registered profile
  (register-agent-profile 'reviewer "You are a Code Reviewer.")
  (assert (equal? (get-agent-system-prompt 'reviewer) "You are a Code Reviewer."))
  (display "  [PASS] Modular agent profiles and system prompts\n"))

;; Test 12: gemini-agent-query cancellation
(let ((error-raised? #f))
  (with-exception-catcher
    (lambda (exc)
      (set! error-raised? #t))
    (lambda ()
      (gemini-agent-query
        "Please read every file in the repository."
        cancelled?: (lambda () #t))))
  (assert error-raised?)
  (display "  [PASS] gemini-agent-query cancelled successfully\n"))

(display "All jazz.ai tests passed successfully!\n")
(force-output (current-output-port))


)
