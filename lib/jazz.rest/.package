(package jazz.rest
  
  (title "REST")
  (description "JSON REST API on the TCP server")
  (authors "Guillaume Cartier")
  (stage experimental)
  (root "src")
  (products (jazz.rest (alias rest)
                       (update jazz.rest)
                       (dependencies jazz
                                     jazz.json
                                     jazz.network)))
  (project ".project"))
